+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.android.server.wm;
+
+import android.graphics.Insets;
+import android.util.DisplayMetrics;
+import android.view.InsetsSource;
+import android.view.InsetsState;
+import android.view.WindowInsets.Type;
+
+/** Insets for the host's status bar and gesture navigation indicator, independent of Android SystemUI. */
+final class DroidloomSystemBarInsets {
+    private static final float NAVIGATION_HEIGHT_DP = 24 * 0.7f;
+    private static final float STATUS_HEIGHT_DP = 33.6f;
+    private static final Object SOURCE_OWNER = new Object();
+    private static final int STATUS_ID = InsetsSource.createId(
+            SOURCE_OWNER, 0, Type.statusBars());
+    private static final int NAVIGATION_ID = InsetsSource.createId(
+            SOURCE_OWNER, 0, Type.navigationBars());
+    private static final int GESTURE_ID = InsetsSource.createId(
+            SOURCE_OWNER, 0, Type.mandatorySystemGestures());
+
+    private DroidloomSystemBarInsets() {}
+
+    static InsetsState apply(InsetsState original, int densityDpi) {
+        final InsetsState state = new InsetsState(original);
+        // A stale/hidden Android source of the same type could overwrite the public
+        // visibility bit. Replace host bar sources only in this app's copy.
+        for (int i = state.sourceSize() - 1; i >= 0; --i) {
+            final InsetsSource source = state.sourceAt(i);
+            if ((source.getType() & (Type.statusBars() | Type.navigationBars()
+                    | Type.mandatorySystemGestures())) != 0) {
+                state.removeSource(source.getId());
+            }
+        }
+        final int dpi = densityDpi > 0 ? densityDpi : DisplayMetrics.DENSITY_DEFAULT;
+        final int height = Math.max(1, Math.round(
+                NAVIGATION_HEIGHT_DP * (dpi / (float) DisplayMetrics.DENSITY_DEFAULT)));
+        final int statusHeight = Math.max(1, Math.round(
+                STATUS_HEIGHT_DP * (dpi / (float) DisplayMetrics.DENSITY_DEFAULT)));
+        final Insets bottom = Insets.of(0, 0, 0, height);
+        // Android 17's attached insets use the recipient's bounds at calculation
+        // time. This follows freeform resize/rotation and both current and maximum
+        // WindowMetrics, without tying an app's indicator to the global display.
+        state.addSource(new InsetsSource(STATUS_ID, Type.statusBars())
+                .setAttachedInsets(Insets.of(0, statusHeight, 0, 0)).setVisible(true)
+                .setFlags(InsetsSource.FLAG_SUPPRESS_SCRIM));
+        state.addSource(new InsetsSource(NAVIGATION_ID, Type.navigationBars())
+                .setAttachedInsets(bottom).setVisible(true)
+                .setFlags(InsetsSource.FLAG_SUPPRESS_SCRIM));
+        // Android also exposes mandatory gestures through Type.systemGestures().
+        // No tappable-element inset: this represents gesture navigation.
+        state.addSource(new InsetsSource(GESTURE_ID, Type.mandatorySystemGestures())
+                .setAttachedInsets(bottom).setVisible(true));
+        return state;
+    }
+}
diff --git a/services/tests/wmtests/src/com/android/server/wm/DroidloomSystemBarInsetsTest.java b/services/tests/wmtests/src/com/android/server/wm/DroidloomSystemBarInsetsTest.java
