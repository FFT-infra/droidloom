on post-fs-data
    mkdir /dev/socket/droidloom-framework 0700 system system
    setprop sys.droidloom.framework_ready 0

on property:init.svc.zygote=stopped
    setprop sys.droidloom.framework_ready 0

on property:init.svc.zygote=restarting
    setprop sys.droidloom.framework_ready 0

service droidloom-ime-setup /system/bin/sh /droidloom/ime/setup
    class late_start
    user shell
    group shell
    disabled
    oneshot
    stdio_to_kmsg

on property:sys.boot_completed=1
    start droidloom-ime-setup
