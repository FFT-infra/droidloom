<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.droidloom.home" android:versionCode="1" android:versionName="1">
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="37" />
    <application android:label="Droidloom Home" android:allowBackup="false"
        android:hardwareAccelerated="false"
        android:theme="@style/DroidloomHomeTheme">
        <!-- Android ignores application-level directBootAware outside the
             system image. On the activity, HOME resolves here at boot and
             Settings is never started for its FallbackHome. -->
        <activity android:name=".HomeActivity" android:exported="true"
            android:directBootAware="true"
            android:excludeFromRecents="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
