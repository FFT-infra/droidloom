+// One outstanding scene bounds queued descriptors and avoids speculative read
+// reuse. Caller holds State::mutex; no callback runs while that lock is held.
+class CommitQueue {
+    uint64_t mNext = 0, mPending = 0;
+    std::vector<uint64_t> mAdded;
+    bool mDeferred = false, mFallback = false;
+public:
+    bool busy() const { return mPending != 0; }
+    bool defer() {
+        if (!busy()) return false;
+        mDeferred = true;
+        return true;
+    }
+    bool takeFallback() { return std::exchange(mFallback, false); }
+    uint64_t begin(std::vector<uint64_t> added) {
+        if (busy() || mNext == UINT64_MAX) return 0;
+        mPending = ++mNext;
+        mAdded = std::move(added);
+        return mPending;
+    }
+    bool complete(const std::vector<uint32_t>& words, std::vector<uint64_t>* rejected,
+                  bool* repaint) {
+        if (words.size() != 3 || !busy() ||
+            (words[0] | static_cast<uint64_t>(words[1]) << 32) != mPending ||
+            static_cast<int32_t>(words[2]) > 0) return false;
+        rejected->clear();
+        if (words[2]) {
+            *rejected = std::move(mAdded);
+            mFallback = true;
+        }
+        mAdded.clear();
+        mPending = 0;
+        *repaint = mDeferred || mFallback;
+        mDeferred = false;
+        return true;
+    }
+};
+
+bool commitAsync(int socket, uint64_t scene, const std::vector<uint8_t>& payload) {
+    std::vector<uint8_t> packet;
+    put64(packet, scene);
+    packet.insert(packet.end(), payload.begin(), payload.end());
+    return send(socket, 9, packet);
+}
