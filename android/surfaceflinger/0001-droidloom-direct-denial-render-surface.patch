+namespace android {
+namespace {
+
+constexpr char kSocketPath[] = "/dev/socket/droidloom-surfaceflinger";
+constexpr std::array<uint8_t, 4> kMagic{'D', 'L', 'S', 'F'};
+constexpr uint16_t kVersion = 3;
+constexpr size_t kHeaderBytes = 16;
+constexpr size_t kMaxRecordBytes = 128;
+constexpr size_t kMaxPlanes = 4;
+constexpr size_t kMaxFds = kMaxPlanes + 1;
+constexpr uint64_t kGrallocMetadataBytes = 16 * 1024;
+constexpr uint32_t kCrosGrallocMagic = 0xABCDDCBA;
+constexpr uint32_t makeFourcc(char a, char b, char c, char d) {
+    return static_cast<uint32_t>(a) | static_cast<uint32_t>(b) << 8 |
+            static_cast<uint32_t>(c) << 16 | static_cast<uint32_t>(d) << 24;
+}
+constexpr uint32_t kDrmFormatArgb8888 = makeFourcc('A', 'R', '2', '4');
+constexpr uint32_t kDrmFormatXrgb8888 = makeFourcc('X', 'R', '2', '4');
+
+// The native-handle ABI consumed by the minigbm mapper. Keep this private to
+// the Droidloom window so SurfaceFlinger does not gain a build dependency on
+// minigbm's otherwise private implementation header.
+struct CrosGrallocHandle : public native_handle_t {
+    int32_t fds[kMaxFds];
+    uint32_t strides[kMaxPlanes];
+    uint32_t offsets[kMaxPlanes];
+    uint32_t sizes[kMaxPlanes];
+    uint32_t id;
+    uint32_t width;
+    uint32_t height;
+    uint32_t format;
+    uint32_t tiling;
+    uint64_t format_modifier;
+    uint64_t use_flags;
+    uint32_t magic;
+    uint32_t pixel_stride;
+    int32_t droid_format;
+    int64_t usage;
+    uint32_t num_planes;
+    uint64_t reserved_region_size;
+    uint64_t total_size;
+} __attribute__((packed));
+
+enum class Opcode : uint16_t {
+    ClientHello = 1,
+    ServerHello = 2,
+    Acquire = 3,
+    Target = 4,
+    Present = 5,
+    Cancel = 6,
+    Ack = 7,
+    Error = 8,
+    Retire = 9,
+};
+
+struct ReceivedRecord {
+    std::array<uint8_t, kMaxRecordBytes> bytes{};
+    size_t length = 0;
+    std::vector<base::unique_fd> descriptors;
+};
+
+uint16_t readU16(const uint8_t* bytes) {
+    return static_cast<uint16_t>(static_cast<uint16_t>(bytes[0]) |
+                                 static_cast<uint16_t>(bytes[1]) << 8);
+}
+
+uint32_t readU32(const uint8_t* bytes) {
+    return static_cast<uint32_t>(bytes[0]) | static_cast<uint32_t>(bytes[1]) << 8 |
+            static_cast<uint32_t>(bytes[2]) << 16 | static_cast<uint32_t>(bytes[3]) << 24;
+}
+
+uint64_t readU64(const uint8_t* bytes) {
+    return static_cast<uint64_t>(readU32(bytes)) |
+            static_cast<uint64_t>(readU32(bytes + 4)) << 32;
+}
+
+void appendU16(std::vector<uint8_t>& bytes, uint16_t value) {
+    bytes.push_back(static_cast<uint8_t>(value));
+    bytes.push_back(static_cast<uint8_t>(value >> 8));
+}
+
+void appendU32(std::vector<uint8_t>& bytes, uint32_t value) {
+    for (unsigned shift = 0; shift < 32; shift += 8) {
+        bytes.push_back(static_cast<uint8_t>(value >> shift));
+    }
+}
+
+void appendU64(std::vector<uint8_t>& bytes, uint64_t value) {
+    appendU32(bytes, static_cast<uint32_t>(value));
+    appendU32(bytes, static_cast<uint32_t>(value >> 32));
+}
+
+std::vector<uint8_t> makeRecord(Opcode opcode, const std::vector<uint8_t>& payload,
+                                uint32_t descriptorCount) {
+    std::vector<uint8_t> bytes;
+    bytes.reserve(kHeaderBytes + payload.size());
+    bytes.insert(bytes.end(), kMagic.begin(), kMagic.end());
+    appendU16(bytes, kVersion);
+    appendU16(bytes, static_cast<uint16_t>(opcode));
+    appendU32(bytes, static_cast<uint32_t>(payload.size()));
+    appendU32(bytes, descriptorCount);
+    bytes.insert(bytes.end(), payload.begin(), payload.end());
+    return bytes;
+}
+
+status_t sendRecord(int socket, const std::vector<uint8_t>& bytes, int descriptor) {
+    iovec iov{.iov_base = const_cast<uint8_t*>(bytes.data()), .iov_len = bytes.size()};
+    msghdr message{};
+    message.msg_iov = &iov;
+    message.msg_iovlen = 1;
+    std::array<uint8_t, CMSG_SPACE(sizeof(int))> control{};
+    if (descriptor >= 0) {
+        message.msg_control = control.data();
+        message.msg_controllen = control.size();
+        cmsghdr* header = CMSG_FIRSTHDR(&message);
+        header->cmsg_level = SOL_SOCKET;
+        header->cmsg_type = SCM_RIGHTS;
+        header->cmsg_len = CMSG_LEN(sizeof(int));
+        std::memcpy(CMSG_DATA(header), &descriptor, sizeof(descriptor));
+    }
+    const ssize_t sent = TEMP_FAILURE_RETRY(sendmsg(socket, &message, MSG_NOSIGNAL));
+    if (sent < 0) return -errno;
+    return static_cast<size_t>(sent) == bytes.size() ? NO_ERROR : -EIO;
+}
+
+status_t receiveRecord(int socket, ReceivedRecord* record) {
+    iovec iov{.iov_base = record->bytes.data(), .iov_len = record->bytes.size()};
+    std::array<uint8_t, CMSG_SPACE(sizeof(int) * kMaxPlanes)> control{};
+    msghdr message{};
+    message.msg_iov = &iov;
+    message.msg_iovlen = 1;
+    message.msg_control = control.data();
+    message.msg_controllen = control.size();
+    const ssize_t received = TEMP_FAILURE_RETRY(recvmsg(socket, &message, MSG_CMSG_CLOEXEC));
+    if (received == 0) return DEAD_OBJECT;
+    if (received < 0) return -errno;
+    if ((message.msg_flags & (MSG_TRUNC | MSG_CTRUNC)) != 0) return -EMSGSIZE;
+    record->length = static_cast<size_t>(received);
+    record->descriptors.clear();
+    for (cmsghdr* header = CMSG_FIRSTHDR(&message); header != nullptr;
+         header = CMSG_NXTHDR(&message, header)) {
+        if (header->cmsg_level != SOL_SOCKET || header->cmsg_type != SCM_RIGHTS ||
+            header->cmsg_len < CMSG_LEN(0)) {
+            return BAD_VALUE;
+        }
+        const size_t bytes = header->cmsg_len - CMSG_LEN(0);
+        if (bytes % sizeof(int) != 0) return BAD_VALUE;
+        const size_t count = bytes / sizeof(int);
+        const int* descriptors = reinterpret_cast<const int*>(CMSG_DATA(header));
+        for (size_t index = 0; index < count; ++index) {
+            if (record->descriptors.size() == kMaxPlanes) return -EMFILE;
+            record->descriptors.emplace_back(descriptors[index]);
+        }
+    }
+    if (record->length < kHeaderBytes ||
+        !std::equal(kMagic.begin(), kMagic.end(), record->bytes.begin()) ||
+        readU16(record->bytes.data() + 4) != kVersion ||
+        kHeaderBytes + readU32(record->bytes.data() + 8) != record->length ||
+        readU32(record->bytes.data() + 12) != record->descriptors.size()) {
+        return BAD_VALUE;
+    }
+    return NO_ERROR;
+}
+
+status_t connectBroker(base::unique_fd* socket) {
+    base::unique_fd fd(::socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0));
+    if (!fd.ok()) return -errno;
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    static_assert(sizeof(kSocketPath) <= sizeof(address.sun_path));
+    std::memcpy(address.sun_path, kSocketPath, sizeof(kSocketPath));
+    const socklen_t length = static_cast<socklen_t>(offsetof(sockaddr_un, sun_path) +
+                                                    sizeof(kSocketPath));
+    if (TEMP_FAILURE_RETRY(connect(fd.get(), reinterpret_cast<sockaddr*>(&address), length)) != 0) {
+        return -errno;
+    }
+    *socket = std::move(fd);
+    return NO_ERROR;
+}
+
+uint32_t planeSize(int fd, uint32_t offset, uint32_t stride, uint32_t height) {
+    const off_t size = lseek(fd, 0, SEEK_END);
+    if (size > 0 && static_cast<uint64_t>(size) <= UINT32_MAX) {
+        return static_cast<uint32_t>(size);
+    }
+    const uint64_t fallback = static_cast<uint64_t>(offset) +
+            static_cast<uint64_t>(stride) * static_cast<uint64_t>(height);
+    return fallback <= UINT32_MAX ? static_cast<uint32_t>(fallback) : 0;
+}
+
+int createGrallocMetadataFd() {
+    const int fd = static_cast<int>(syscall(__NR_memfd_create, "Droidloom gralloc metadata",
+                                            FD_CLOEXEC));
+    if (fd < 0) return -errno;
+    if (ftruncate(fd, static_cast<off_t>(kGrallocMetadataBytes)) != 0) {
+        const int error = errno;
+        close(fd);
+        return -error;
+    }
+    return fd;
+}
+
+PixelFormat androidFormat(uint32_t fourcc) {
+    switch (fourcc) {
+        case kDrmFormatArgb8888:
+        case kDrmFormatXrgb8888:
+            // Skia's GL AHardwareBuffer path does not classify Android's
+            // legacy BGRA enum as renderable.  The minigbm handle still
+            // carries the authoritative DRM fourcc (AR24/XR24), which Mesa
+            // uses for EGLImage import, so advertise the equivalent
+            // renderable RGBA8 storage class to Skia here.
+            return PIXEL_FORMAT_RGBA_8888;
+        default:
+            return PIXEL_FORMAT_UNKNOWN;
+    }
+}
+
+} // namespace
+
+sp<DroidloomNativeWindow> DroidloomNativeWindow::create(uint32_t expectedWidth,
+                                                         uint32_t expectedHeight) {
+    auto window = sp<DroidloomNativeWindow>::make(uint64_t{0}, expectedWidth, expectedHeight);
+    if (const status_t status = window->initialize(); status != NO_ERROR) {
+        ALOGE("Failed to initialize direct render window: %d (%s)", status, strerror(-status));
+        return nullptr;
+    }
+    return window;
+}
+
+sp<DroidloomNativeWindow> DroidloomNativeWindow::createForTask(uint64_t task,
+                                                                status_t* outStatus) {
+    if (outStatus == nullptr) return nullptr;
+    if (task == 0 || task > INT32_MAX) {
+        *outStatus = BAD_VALUE;
+        return nullptr;
+    }
+    auto window = sp<DroidloomNativeWindow>::make(task, uint32_t{0}, uint32_t{0});
+    *outStatus = window->initialize();
+    if (*outStatus != NO_ERROR) {
+        if (*outStatus != NAME_NOT_FOUND && *outStatus != WOULD_BLOCK) {
+            ALOGE("Failed to initialize task %" PRIu64 " render window: %d (%s)", task,
+                  *outStatus, strerror(-*outStatus));
+        }
+        return nullptr;
+    }
+    return window;
+}
+
+DroidloomNativeWindow::DroidloomNativeWindow(uint64_t task, uint32_t expectedWidth,
+                                               uint32_t expectedHeight)
+      : mTask(task), mExpectedWidth(expectedWidth), mExpectedHeight(expectedHeight) {
+    ANativeWindow::setSwapInterval = hookSetSwapInterval;
+    ANativeWindow::dequeueBuffer = hookDequeueBuffer;
+    ANativeWindow::queueBuffer = hookQueueBuffer;
+    ANativeWindow::cancelBuffer = hookCancelBuffer;
+    ANativeWindow::query = hookQuery;
+    ANativeWindow::perform = hookPerform;
+    ANativeWindow::dequeueBuffer_DEPRECATED = hookDequeueBufferDeprecated;
+    ANativeWindow::queueBuffer_DEPRECATED = hookQueueBufferDeprecated;
+    ANativeWindow::cancelBuffer_DEPRECATED = hookCancelBufferDeprecated;
+    ANativeWindow::lockBuffer_DEPRECATED = hookLockBufferDeprecated;
+    const_cast<int&>(ANativeWindow::minSwapInterval) = 0;
+    const_cast<int&>(ANativeWindow::maxSwapInterval) = 1;
+}
+
+DroidloomNativeWindow::~DroidloomNativeWindow() {
+    std::lock_guard lock(mMutex);
+    if (mTask == 0 || mDisplay == 0 || !mSocket.ok()) return;
+    std::vector<uint8_t> payload;
+    appendU64(payload, mDisplay);
+    if (sendRecord(mSocket.get(), makeRecord(Opcode::Retire, payload, 0), -1) == NO_ERROR) {
+        (void)receiveAck();
+    }
+}
+
+status_t DroidloomNativeWindow::initialize() {
+    status_t status = connectBroker(&mSocket);
+    if (status != NO_ERROR) return status;
+    std::vector<uint8_t> hello;
+    appendU64(hello, mTask);
+    status = sendRecord(mSocket.get(), makeRecord(Opcode::ClientHello, hello, 0), -1);
+    if (status != NO_ERROR) return status;
+    ReceivedRecord record;
+    status = receiveRecord(mSocket.get(), &record);
+    if (status != NO_ERROR) return status;
+    const Opcode opcode = static_cast<Opcode>(readU16(record.bytes.data() + 6));
+    if (opcode == Opcode::Error && record.length == kHeaderBytes + 4 &&
+        record.descriptors.empty()) {
+        const int32_t error = static_cast<int32_t>(readU32(record.bytes.data() + kHeaderBytes));
+        return error < 0 ? error : UNKNOWN_ERROR;
+    }
+    if (opcode != Opcode::ServerHello ||
+        record.length != kHeaderBytes + 16 || !record.descriptors.empty()) {
+        return BAD_VALUE;
+    }
+    const uint8_t* payload = record.bytes.data() + kHeaderBytes;
+    mDisplay = readU64(payload);
+    mWidth = readU32(payload + 8);
+    mHeight = readU32(payload + 12);
+    if (mDisplay == 0 || mWidth == 0 || mHeight == 0 ||
+        (mExpectedWidth != 0 && mWidth != mExpectedWidth) ||
+        (mExpectedHeight != 0 && mHeight != mExpectedHeight)) {
+        ALOGE("Broker display mismatch: HWC=%ux%u broker=%" PRIu64 " %ux%u", mExpectedWidth,
+              mExpectedHeight, mDisplay, mWidth, mHeight);
+        return BAD_VALUE;
+    }
+    ALOGI("Using Denial-owned targets for %s %" PRIu64 " on channel %" PRIu64 " at %ux%u",
+          mTask == 0 ? "built-in display" : "Android task", mTask, mDisplay, mWidth, mHeight);
+    return NO_ERROR;
+}
+
+int DroidloomNativeWindow::dequeueBuffer(ANativeWindowBuffer** output, int* fenceFd) {
+    if (output == nullptr || fenceFd == nullptr) return BAD_VALUE;
+    std::lock_guard lock(mMutex);
+
+    for (;;) {
+        status_t status = sendRequest(static_cast<uint16_t>(Opcode::Acquire), 0);
+        if (status != NO_ERROR) return status;
+        ReceivedRecord record;
+        status = receiveRecord(mSocket.get(), &record);
+        if (status != NO_ERROR) return status;
+        const Opcode opcode = static_cast<Opcode>(readU16(record.bytes.data() + 6));
+        if (opcode == Opcode::Error && record.length == kHeaderBytes + 4) {
+            const int32_t error = static_cast<int32_t>(readU32(record.bytes.data() + kHeaderBytes));
+            if (error == -EAGAIN) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(1));
+                continue;
+            }
+            ALOGE("Broker acquire failed: %d with %zu buffers dequeued", error,
+                  mDequeued.size());
+            return error < 0 ? error : -EIO;
+        }
+        if (opcode != Opcode::Target || record.length != kHeaderBytes + 80) return BAD_VALUE;
+
+        const uint8_t* payload = record.bytes.data() + kHeaderBytes;
+        const uint64_t display = readU64(payload);
+        const uint64_t id = readU64(payload + 8);
+        const uint32_t serial = readU32(payload + 16);
+        const uint32_t width = readU32(payload + 20);
+        const uint32_t height = readU32(payload + 24);
+        const uint32_t fourcc = readU32(payload + 28);
+        const uint64_t modifier = readU64(payload + 32);
+        const uint32_t planeCount = readU32(payload + 40);
+        const auto failAcquired = [&](status_t failure) -> status_t {
+            if (id == 0) return failure;
+            status_t cancellation = sendRequest(static_cast<uint16_t>(Opcode::Cancel), id);
+            if (cancellation == NO_ERROR) cancellation = receiveAck();
+            if (cancellation != NO_ERROR) {
+                ALOGE("Failed to cancel rejected Denial target %" PRIu64 ": %d", id,
+                      cancellation);
+            }
+            return failure;
+        };
+        if (display != mDisplay || id == 0 || id > UINT32_MAX || serial == 0 || width == 0 ||
+            height == 0 || planeCount == 0 || planeCount > kMaxPlanes ||
+            record.descriptors.size() != planeCount) {
+            return failAcquired(BAD_VALUE);
+        }
+        if (width != mWidth || height != mHeight) {
+            ALOGI("Denial resized %s %" PRIu64 " on channel %" PRIu64 " from %ux%u to %ux%u",
+                  mTask == 0 ? "built-in display" : "Android task", mTask, mDisplay, mWidth,
+                  mHeight, width, height);
+            mWidth = width;
+            mHeight = height;
+        }
+
+        auto target = mTargets.find(id);
+        if (target == mTargets.end()) {
+            const PixelFormat format = androidFormat(fourcc);
+            if (format == PIXEL_FORMAT_UNKNOWN) return failAcquired(BAD_VALUE);
+            // Stable-C minigbm handles carry a gralloc metadata sidecar after
+            // their plane descriptors. It is required even when no client
+            // reserved region was requested: Mesa queries the default
+            // dataspace through it while constructing the EGLImage.
+            const int numFds = static_cast<int>(planeCount + 1);
+            const int numInts = static_cast<int>(
+                    (sizeof(CrosGrallocHandle) - sizeof(native_handle_t)) / sizeof(int)) -
+                    numFds;
+            native_handle_t* native = native_handle_create(numFds, numInts);
+            if (native == nullptr) return failAcquired(NO_MEMORY);
+            auto* handle = reinterpret_cast<CrosGrallocHandle*>(native);
+            std::memset(handle->fds, 0xff, sizeof(handle->fds));
+            std::memset(handle->strides, 0, sizeof(handle->strides));
+            std::memset(handle->offsets, 0, sizeof(handle->offsets));
+            std::memset(handle->sizes, 0, sizeof(handle->sizes));
+            uint64_t totalSize = 0;
+            for (uint32_t index = 0; index < planeCount; ++index) {
+                handle->fds[index] = record.descriptors[index].release();
+                handle->offsets[index] = readU32(payload + 48 + index * 4);
+                handle->strides[index] = readU32(payload + 64 + index * 4);
+                handle->sizes[index] = planeSize(handle->fds[index], handle->offsets[index],
+                                                  handle->strides[index], height);
+                totalSize += handle->sizes[index];
+            }
+            handle->fds[planeCount] = createGrallocMetadataFd();
+            if (handle->fds[planeCount] < 0) {
+                const status_t failure = handle->fds[planeCount];
+                native_handle_close(native);
+                native_handle_delete(native);
+                return failAcquired(failure);
+            }
+            // minigbm buffer identities are process-global, whereas Denial
+            // identities occupy a separate namespace and can collide with
+            // ordinary Android allocations already imported by SurfaceFlinger.
+            static std::atomic<uint32_t> nextGrallocId{0xd1000000U};
+            handle->id = nextGrallocId.fetch_add(1, std::memory_order_relaxed);
+            handle->width = width;
+            handle->height = height;
+            handle->format = fourcc;
+            handle->tiling = 0;
+            handle->format_modifier = modifier;
+            // Denial allocated these targets as GBM renderable scanout BOs.
+            handle->use_flags = (1ULL << 0) | (1ULL << 2);
+            handle->magic = kCrosGrallocMagic;
+            handle->pixel_stride = handle->strides[0] / 4;
+            handle->droid_format = format;
+            handle->usage = static_cast<int64_t>(mUsage);
+            handle->num_planes = planeCount;
+            handle->reserved_region_size = kGrallocMetadataBytes;
+            handle->total_size = totalSize + kGrallocMetadataBytes;
+            auto graphicBuffer = sp<GraphicBuffer>::make(
+                    native, GraphicBuffer::TAKE_UNREGISTERED_HANDLE, width, height, format, 1U,
+                    mUsage, handle->pixel_stride);
+            const status_t importStatus = graphicBuffer->initCheck();
+            if (importStatus != NO_ERROR) {
+                ALOGE("Failed to import Denial target %" PRIu64
+                      " as minigbm buffer %u: %d (fourcc=%#x modifier=%#" PRIx64
+                      " stride=%u)",
+                      id, handle->id, importStatus, fourcc, modifier, handle->strides[0]);
+                native_handle_close(native);
+                native_handle_delete(native);
+                return failAcquired(importStatus);
+            }
+            Target imported{.buffer = std::move(graphicBuffer)};
+            mBufferIds.emplace(imported.buffer->getNativeBuffer(), id);
+            target = mTargets.emplace(id, std::move(imported)).first;
+        }
+        mDequeued.insert(id);
+        ALOGV("Dequeued Denial target %" PRIu64 "; %zu buffers now dequeued", id,
+              mDequeued.size());
+        *output = target->second.buffer->getNativeBuffer();
+        *fenceFd = -1;
+        return NO_ERROR;
+    }
+}
+
+int DroidloomNativeWindow::queueBuffer(ANativeWindowBuffer* buffer, int fenceFd) {
+    std::lock_guard lock(mMutex);
+    base::unique_fd fence(fenceFd);
+    const auto found = mBufferIds.find(buffer);
+    if (found == mBufferIds.end() || mDequeued.count(found->second) == 0) return BAD_VALUE;
+    const uint64_t id = found->second;
+    status_t status = sendRequest(static_cast<uint16_t>(Opcode::Present), id, fence.get());
+    if (status == NO_ERROR) status = receiveAck();
+    mDequeued.erase(id);
+    ALOGV("Queued Denial target %" PRIu64 "; status=%d, %zu buffers remain dequeued", id,
+          status, mDequeued.size());
+    return status;
+}
+
+int DroidloomNativeWindow::cancelBuffer(ANativeWindowBuffer* buffer, int fenceFd) {
+    std::lock_guard lock(mMutex);
+    base::unique_fd fence(fenceFd);
+    const auto found = mBufferIds.find(buffer);
+    if (found == mBufferIds.end() || mDequeued.count(found->second) == 0) return BAD_VALUE;
+    if (fence.ok()) sync_wait(fence.get(), -1);
+    const uint64_t id = found->second;
+    status_t status = sendRequest(static_cast<uint16_t>(Opcode::Cancel), id);
+    if (status == NO_ERROR) status = receiveAck();
+    mDequeued.erase(id);
+    ALOGV("Cancelled Denial target %" PRIu64 "; status=%d, %zu buffers remain dequeued", id,
+          status, mDequeued.size());
+    return status;
+}
+
+int DroidloomNativeWindow::query(int what, int* value) const {
+    if (value == nullptr) return BAD_VALUE;
+    std::lock_guard lock(mMutex);
+    switch (what) {
+        case NATIVE_WINDOW_WIDTH:
+        case NATIVE_WINDOW_DEFAULT_WIDTH:
+            *value = static_cast<int>(mWidth);
+            return NO_ERROR;
+        case NATIVE_WINDOW_HEIGHT:
+        case NATIVE_WINDOW_DEFAULT_HEIGHT:
+            *value = static_cast<int>(mHeight);
+            return NO_ERROR;
+        case NATIVE_WINDOW_FORMAT:
+            *value = mFormat;
+            return NO_ERROR;
+        case NATIVE_WINDOW_MIN_UNDEQUEUED_BUFFERS:
+            *value = 0;
+            return NO_ERROR;
+        case NATIVE_WINDOW_QUEUES_TO_WINDOW_COMPOSER:
+        case NATIVE_WINDOW_CONSUMER_RUNNING_BEHIND:
+        case NATIVE_WINDOW_BUFFER_AGE:
+            *value = 0;
+            return NO_ERROR;
+        case NATIVE_WINDOW_CONCRETE_TYPE:
+        case NATIVE_WINDOW_TRANSFORM_HINT:
+            *value = 0;
+            return NO_ERROR;
+        case NATIVE_WINDOW_IS_VALID:
+            *value = mSocket.ok() ? 1 : 0;
+            return NO_ERROR;
+        case NATIVE_WINDOW_DATASPACE:
+            *value = static_cast<int>(mDataspace);
+            return NO_ERROR;
+        case NATIVE_WINDOW_MAX_BUFFER_COUNT:
+            *value = 3;
+            return NO_ERROR;
+        default:
+            return NAME_NOT_FOUND;
+    }
+}
+
+int DroidloomNativeWindow::perform(int operation, va_list args) {
+    std::lock_guard lock(mMutex);
+    switch (operation) {
+        case NATIVE_WINDOW_API_CONNECT:
+            (void)va_arg(args, int);
+            if (mConnected) return -EINVAL;
+            mConnected = true;
+            return NO_ERROR;
+        case NATIVE_WINDOW_API_DISCONNECT:
+            (void)va_arg(args, int);
+            mConnected = false;
+            return NO_ERROR;
+        case NATIVE_WINDOW_SET_USAGE64:
+            mUsage = va_arg(args, uint64_t);
+            return NO_ERROR;
+        case NATIVE_WINDOW_SET_USAGE:
+            mUsage = static_cast<uint32_t>(va_arg(args, int));
+            return NO_ERROR;
+        case NATIVE_WINDOW_SET_BUFFERS_FORMAT:
+            (void)va_arg(args, int);
+            return NO_ERROR;
+        case NATIVE_WINDOW_SET_BUFFERS_DATASPACE:
+            mDataspace = static_cast<ui::Dataspace>(va_arg(args, int));
+            return NO_ERROR;
+        case NATIVE_WINDOW_SET_BUFFERS_DIMENSIONS: {
+            const int width = va_arg(args, int);
+            const int height = va_arg(args, int);
+            // Denial owns the window geometry. The next acquired target is
+            // authoritative and updates mWidth/mHeight when its generation changes.
+            return width > 0 && height > 0 ? NO_ERROR : BAD_VALUE;
+        }
+        case NATIVE_WINDOW_SET_SURFACE_DAMAGE:
+            (void)va_arg(args, android_native_rect_t*);
+            (void)va_arg(args, size_t);
+            return NO_ERROR;
+        case NATIVE_WINDOW_ALLOCATE_BUFFERS:
+        case NATIVE_WINDOW_SET_PRODUCER_THROTTLING_ENABLED:
+            return NO_ERROR;
+        default:
+            return NAME_NOT_FOUND;
+    }
+}
+
+status_t DroidloomNativeWindow::sendRequest(uint16_t opcode, uint64_t buffer, int fenceFd) {
+    std::vector<uint8_t> payload;
+    appendU64(payload, mDisplay);
+    if (static_cast<Opcode>(opcode) == Opcode::Present ||
+        static_cast<Opcode>(opcode) == Opcode::Cancel) {
+        appendU64(payload, buffer);
+    }
+    const uint32_t descriptors = fenceFd >= 0 ? 1 : 0;
+    return sendRecord(mSocket.get(), makeRecord(static_cast<Opcode>(opcode), payload, descriptors),
+                      fenceFd);
+}
+
+status_t DroidloomNativeWindow::receiveAck() {
+    ReceivedRecord record;
+    status_t status = receiveRecord(mSocket.get(), &record);
+    if (status != NO_ERROR) return status;
+    const Opcode opcode = static_cast<Opcode>(readU16(record.bytes.data() + 6));
+    if (opcode == Opcode::Ack && record.length == kHeaderBytes && record.descriptors.empty()) {
+        return NO_ERROR;
+    }
+    if (opcode == Opcode::Error && record.length == kHeaderBytes + 4) {
+        const int32_t error = static_cast<int32_t>(readU32(record.bytes.data() + kHeaderBytes));
+        return error < 0 ? error : -EIO;
+    }
+    return BAD_VALUE;
+}
+
+int DroidloomNativeWindow::hookSetSwapInterval(ANativeWindow*, int) {
+    return NO_ERROR;
+}
+
+int DroidloomNativeWindow::hookDequeueBuffer(ANativeWindow* window, ANativeWindowBuffer** buffer,
+                                              int* fenceFd) {
+    return getSelf(window)->dequeueBuffer(buffer, fenceFd);
+}
+
+int DroidloomNativeWindow::hookQueueBuffer(ANativeWindow* window, ANativeWindowBuffer* buffer,
+                                            int fenceFd) {
+    return getSelf(window)->queueBuffer(buffer, fenceFd);
+}
+
+int DroidloomNativeWindow::hookCancelBuffer(ANativeWindow* window, ANativeWindowBuffer* buffer,
+                                             int fenceFd) {
+    return getSelf(window)->cancelBuffer(buffer, fenceFd);
+}
+
+int DroidloomNativeWindow::hookQuery(const ANativeWindow* window, int what, int* value) {
+    return getSelf(window)->query(what, value);
+}
+
+int DroidloomNativeWindow::hookPerform(ANativeWindow* window, int operation, ...) {
+    va_list args;
+    va_start(args, operation);
+    const int result = getSelf(window)->perform(operation, args);
+    va_end(args);
+    return result;
+}
+
+int DroidloomNativeWindow::hookDequeueBufferDeprecated(ANativeWindow* window,
+                                                        ANativeWindowBuffer** buffer) {
+    int fence = -1;
+    const int result = getSelf(window)->dequeueBuffer(buffer, &fence);
+    if (result == NO_ERROR && fence >= 0) {
+        const int wait = sync_wait(fence, -1);
+        close(fence);
+        return wait == 0 ? NO_ERROR : -errno;
+    }
+    return result;
+}
+
+int DroidloomNativeWindow::hookQueueBufferDeprecated(ANativeWindow* window,
+                                                      ANativeWindowBuffer* buffer) {
+    return getSelf(window)->queueBuffer(buffer, -1);
+}
+
+int DroidloomNativeWindow::hookCancelBufferDeprecated(ANativeWindow* window,
+                                                       ANativeWindowBuffer* buffer) {
+    return getSelf(window)->cancelBuffer(buffer, -1);
+}
+
+int DroidloomNativeWindow::hookLockBufferDeprecated(ANativeWindow*, ANativeWindowBuffer*) {
+    return NO_ERROR;
+}
+
+} // namespace android
