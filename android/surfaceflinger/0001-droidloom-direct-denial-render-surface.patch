+namespace android {
+
+// ANativeWindow backed by the cell-private Droidloom presentation broker.
+// RenderEngine writes the final SurfaceFlinger display composition directly
+// into Denial-owned DMA-BUFs returned by dequeueBuffer().
+class DroidloomNativeWindow final
+      : public ANativeObjectBase<ANativeWindow, DroidloomNativeWindow, RefBase> {
+public:
+    static sp<DroidloomNativeWindow> create(uint32_t expectedWidth, uint32_t expectedHeight);
+    static sp<DroidloomNativeWindow> createForTask(uint64_t task, status_t* outStatus);
+
+    DroidloomNativeWindow(uint64_t task, uint32_t expectedWidth, uint32_t expectedHeight);
+    ~DroidloomNativeWindow() override;
+
+private:
+    struct Target {
+        sp<GraphicBuffer> buffer;
+    };
+
+    status_t initialize();
+    int dequeueBuffer(ANativeWindowBuffer** buffer, int* fenceFd);
+    int queueBuffer(ANativeWindowBuffer* buffer, int fenceFd);
+    int cancelBuffer(ANativeWindowBuffer* buffer, int fenceFd);
+    int query(int what, int* value) const;
+    int perform(int operation, va_list args);
+
+    static int hookSetSwapInterval(ANativeWindow* window, int interval);
+    static int hookDequeueBuffer(ANativeWindow* window, ANativeWindowBuffer** buffer, int* fenceFd);
+    static int hookQueueBuffer(ANativeWindow* window, ANativeWindowBuffer* buffer, int fenceFd);
+    static int hookCancelBuffer(ANativeWindow* window, ANativeWindowBuffer* buffer, int fenceFd);
+    static int hookQuery(const ANativeWindow* window, int what, int* value);
+    static int hookPerform(ANativeWindow* window, int operation, ...);
+    static int hookDequeueBufferDeprecated(ANativeWindow* window, ANativeWindowBuffer** buffer);
+    static int hookQueueBufferDeprecated(ANativeWindow* window, ANativeWindowBuffer* buffer);
+    static int hookCancelBufferDeprecated(ANativeWindow* window, ANativeWindowBuffer* buffer);
+    static int hookLockBufferDeprecated(ANativeWindow*, ANativeWindowBuffer*);
+
+    status_t sendRequest(uint16_t opcode, uint64_t buffer, int fenceFd = -1);
+    status_t receiveAck();
+
+    const uint64_t mTask;
+    const uint32_t mExpectedWidth;
+    const uint32_t mExpectedHeight;
+    uint32_t mWidth = 0;
+    uint32_t mHeight = 0;
+    uint64_t mDisplay = 0;
+    uint64_t mUsage = GRALLOC_USAGE_HW_RENDER | GRALLOC_USAGE_HW_TEXTURE;
+    int mFormat = HAL_PIXEL_FORMAT_RGBA_8888;
+    ui::Dataspace mDataspace = ui::Dataspace::UNKNOWN;
+    bool mConnected = false;
+    android::base::unique_fd mSocket;
+    std::unordered_map<uint64_t, Target> mTargets;
+    std::unordered_map<const ANativeWindowBuffer*, uint64_t> mBufferIds;
+    std::unordered_set<uint64_t> mDequeued;
+    mutable std::mutex mMutex;
+};
+
+} // namespace android
