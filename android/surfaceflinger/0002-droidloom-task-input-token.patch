+    std::unordered_map<int32_t, sp<IBinder>> mDroidloomTaskInputTokens
+            GUARDED_BY(mDroidloomTaskInputMutex);
     State mCurrentState;
     std::atomic<int32_t> mTransactionFlags = 0;
     std::atomic<uint32_t> mUniqueTransactionId = 1;
