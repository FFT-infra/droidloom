diff --git a/services/surfaceflinger/DroidloomImportRetention.h b/services/surfaceflinger/DroidloomImportRetention.h
new file mode 100644
--- /dev/null
+++ b/services/surfaceflinger/DroidloomImportRetention.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <cstddef>
+#include <map>
+#include <vector>
+
+namespace android {
+struct DroidloomImportUse {
+    uint32_t layer, width, height, format;
+    uint64_t bytes, serial;
+
+    bool compatible(const DroidloomImportUse& other) const {
+        return layer == other.layer && width == other.width && height == other.height &&
+                format == other.format;
+    }
+};
+
+// Keep rotating producer pools warm, not every allocation seen during a resize.
+// These bounds apply to reusable spares. Current and GPU-busy allocations must
+// survive even above budget; the existing protocol cap still bounds admission.
+// Only the host's successful unregister reply permits erasing an owning entry.
+template <typename Cache, typename Retire>
+bool trimDroidloomImports(Cache& cache,
+                         const std::map<uint64_t, DroidloomImportUse>& current,
+                         Retire retire) {
+    constexpr std::size_t kSpareCount = 12, kSparesPerLayer = 3;
+    constexpr uint64_t kSpareBytes = 96ull * 1024 * 1024;
+    std::map<uint32_t, DroidloomImportUse> layers;
+    for (const auto& [id, use] : current) {
+        layers.insert_or_assign(use.layer, use);
+        auto it = cache.find(id);
+        if (it != cache.end()) it->second.use = use;
+    }
+    std::vector<uint64_t> idle;
+    idle.reserve(cache.size());
+    for (const auto& [id, entry] : cache) {
+        if (!current.contains(id)) idle.push_back(id);
+    }
+    std::sort(idle.begin(), idle.end(), [&](uint64_t a, uint64_t b) {
+        const auto sa = cache.at(a).use.serial, sb = cache.at(b).use.serial;
+        return sa != sb ? sa > sb : a > b;
+    });
+    uint64_t retainedBytes = 0;
+    std::size_t retainedCount = 0;
+    std::map<uint32_t, std::size_t> perLayer;
+    bool retry = false;
+    for (uint64_t id : idle) {
+        const auto& use = cache.at(id).use;
+        auto layer = layers.find(use.layer);
+        if (layer != layers.end() && use.compatible(layer->second) &&
+            retainedCount < kSpareCount && perLayer[use.layer] < kSparesPerLayer &&
+            use.bytes != 0 && use.bytes <= kSpareBytes - retainedBytes) {
+            ++retainedCount;
+            ++perLayer[use.layer];
+            retainedBytes += use.bytes;
+            continue;
+        }
+        if (retire(id)) cache.erase(id);
+        else retry = true;
+    }
+    return retry;
+}
+} // namespace android
