+    if (mDroidloomHeadlessFence) {
+        // The bootstrap target is discarded by the host. Preserve all normal
+        // present/release operations, but do not render the same task layers a
+        // second time. Their real GPU completion fence protects source reuse.
+        sp<Fence> ready = mDroidloomHeadlessFence;
+        bool valid = true;
+        if (fd.get() >= 0) {
