diff --git a/services/surfaceflinger/DroidloomTiming.h b/services/surfaceflinger/DroidloomTiming.h
new file mode 100644
--- /dev/null
+++ b/services/surfaceflinger/DroidloomTiming.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <cstdint>
+
+namespace android {
+struct DroidloomTimingStamp { uint64_t wall_ns, cpu_ns; };
+extern "C" DroidloomTimingStamp droidloom_timing_start(uint64_t frame);
+extern "C" void droidloom_timing_finish(uint32_t stage, uint64_t object, uint64_t frame,
+                                       uint64_t layers, uint64_t outcome, DroidloomTimingStamp start);
+// Numeric IDs are paired with runtime/droidloom-timing/src/lib.rs.
+enum class DroidloomTimingStage : uint32_t {
+    Composite, TaskScan, SnapshotCopy, DirectPrepare, DirectPublish,
+    FallbackRender, BootstrapPresent, BootstrapRequests,
+    BootstrapState, BootstrapBegin, BootstrapPrepare, BootstrapFinish,
+    BootstrapDequeue, BootstrapQueue, BootstrapHwcPresent, BootstrapComplete,
+    BootstrapRelease, BootstrapCache,
+};
+class DroidloomTimingSpan {
+    DroidloomTimingStage mStage;
+    uint64_t mFrame, mObject, mLayers, mOutcome = 1;
+    DroidloomTimingStamp mStart{};
+public:
+    DroidloomTimingSpan(DroidloomTimingStage stage, uint64_t frame,
+                       uint64_t object = 0, uint64_t layers = 0)
+          : mStage(stage), mFrame(frame), mObject(object), mLayers(layers) {
+        if (frame % 8 == 1) mStart = droidloom_timing_start(frame);
+    }
+    DroidloomTimingSpan(const DroidloomTimingSpan&) = delete;
+    DroidloomTimingSpan& operator=(const DroidloomTimingSpan&) = delete;
+    ~DroidloomTimingSpan() { stop(); }
+    void layers(uint64_t value) { mLayers = value; }
+    void outcome(bool success) { mOutcome = success ? 1 : 0; }
+    void stop() {
+        if (mStart.wall_ns == 0) return;
+        droidloom_timing_finish(static_cast<uint32_t>(mStage), mObject, mFrame,
+                               mLayers, mOutcome, mStart);
+        mStart = {};
+    }
+};
+} // namespace android
