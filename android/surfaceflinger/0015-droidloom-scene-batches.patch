+// One packet for ordinary scenes. Large scenes use invisible chunks, retaining
+// the four-descriptor bound and one asynchronous acceptance for the whole scene.
+// Storage is retained across frames; descriptor integers remain borrowed until
+// sendmsg duplicates them. A failed prefix is discarded through normal Abort.
+class SceneBatch {
+    std::vector<uint8_t> mLayers, mPacket;
+    std::vector<int> mFds;
+    uint32_t mCount = 0;
+    void entries() {
+        put32(mPacket, mCount);
+        mPacket.insert(mPacket.end(), mLayers.begin(), mLayers.end());
+    }
+    bool flush(int socket) {
+        mPacket.clear();
+        entries();
+        if (!send(socket, 11, mPacket, mFds)) return false;
+        begin();
+        return true;
+    }
+public:
+    SceneBatch() { mLayers.reserve(16 * 76); mPacket.reserve(28 + 16 * 76); mFds.reserve(4); }
+    void begin() { mLayers.clear(); mFds.clear(); mCount = 0; }
+    bool add(int socket, const std::vector<uint8_t>& layer, const std::vector<int>& fds) {
+        if (layer.size() != 72 || fds.size() > 1) return false;
+        if (mCount == 16 || (!fds.empty() && mFds.size() == 4)) {
+            if (!flush(socket)) return false;
+        }
+        mLayers.insert(mLayers.end(), layer.begin(), layer.end());
+        put32(mLayers, fds.empty() ? UINT32_MAX : static_cast<uint32_t>(mFds.size()));
+        mFds.insert(mFds.end(), fds.begin(), fds.end());
+        ++mCount;
+        return true;
+    }
+    bool commit(int socket, uint64_t scene, const std::vector<uint8_t>& commit) {
+        if (!mCount || commit.size() != 16) return false;
+        mPacket.clear();
+        put64(mPacket, scene);
+        mPacket.insert(mPacket.end(), commit.begin(), commit.end());
+        entries();
+        return send(socket, 12, mPacket, mFds);
+    }
+};
