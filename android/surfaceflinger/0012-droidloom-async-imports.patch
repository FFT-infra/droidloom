+// Import results may arrive out of order. They authorize scene references,
+// never producer reuse or completion of any previously submitted read.
+// Caller holds State::mutex. Allocation references live in mBuffers.
+class ImportQueue {
+public:
+    enum class Status { Missing, Pending, Ready, Failed };
+    static constexpr size_t kLimit = 16, kCapacity = 128;
+private:
+    struct Entry { uint64_t attempt; Status status; };
+    std::map<uint64_t, Entry> mEntries;
+    uint64_t mNext = 0;
+    size_t mPending = 0;
+public:
+    Status status(uint64_t buffer) const {
+        auto it = mEntries.find(buffer);
+        return it == mEntries.end() ? Status::Missing : it->second.status;
+    }
+    uint64_t begin(uint64_t buffer) {
+        if (!buffer || status(buffer) != Status::Missing || mNext == UINT64_MAX ||
+            mPending == kLimit || mEntries.size() == kCapacity) return 0;
+        const uint64_t attempt = ++mNext;
+        mEntries.emplace(buffer, Entry{attempt, Status::Pending});
+        ++mPending;
+        return attempt;
+    }
+    bool complete(const std::vector<uint32_t>& words, bool* repaint) {
+        if (words.size() != 5 || static_cast<int32_t>(words[4]) > 0) return false;
+        const uint64_t attempt = words[0] | static_cast<uint64_t>(words[1]) << 32;
+        const uint64_t buffer = words[2] | static_cast<uint64_t>(words[3]) << 32;
+        auto it = mEntries.find(buffer);
+        if (it == mEntries.end() || it->second.status != Status::Pending ||
+            it->second.attempt != attempt) return false;
+        it->second.status = words[4] == 0 ? Status::Ready : Status::Failed;
+        *repaint = --mPending == 0;
+        return true;
+    }
+    bool ready(const std::set<uint64_t>& buffers) const {
+        return std::all_of(buffers.begin(), buffers.end(),
+                           [&](uint64_t buffer) { return status(buffer) == Status::Ready; });
+    }
+    bool forget(uint64_t buffer) {
+        if (status(buffer) == Status::Pending) return false;
+        mEntries.erase(buffer);
+        return true;
+    }
+};
+
+bool importBuffer(int socket, uint64_t attempt, const std::vector<uint8_t>& payload,
+                  const std::vector<int>& fds) {
+    if (attempt) {
+        std::vector<uint8_t> packet;
+        put64(packet, attempt);
+        packet.insert(packet.end(), payload.begin(), payload.end());
+        return send(socket, 10, packet, fds);
+    }
+    std::vector<uint32_t> reply;
+    return send(socket, 2, payload, fds) && receive(socket, 0x8001, &reply) &&
+            reply.size() == 1 && reply[0] == 0;
+}
