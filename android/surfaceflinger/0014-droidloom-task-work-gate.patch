new file mode 100644
index 0000000..bb8d04d
--- /dev/null
+++ b/services/surfaceflinger/DroidloomTaskWork.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <cstdint>
+#include <vector>
+
+namespace android {
+// Only acknowledged work is reusable. A wake arriving during preparation has
+// a newer revision and remains pending even if the older frame succeeds.
+class DroidloomTaskWork {
+    std::vector<uint64_t> mCandidate, mAccepted;
+    uint64_t mRevision = 0;
+    bool mValid = false;
+public:
+    void begin() { mCandidate.clear(); }
+    void add(uint64_t value) { mCandidate.push_back(value); }
+    bool needed(uint64_t revision, bool dirty) const {
+        return dirty || !mValid || mRevision != revision || mCandidate != mAccepted;
+    }
+    void accept(uint64_t revision) {
+        mAccepted.swap(mCandidate);
+        mRevision = revision;
+        mValid = true;
+    }
+};
+} // namespace android
