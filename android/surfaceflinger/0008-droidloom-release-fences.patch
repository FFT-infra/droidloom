new file mode 100644
index 0000000..f41cb80
--- /dev/null
+++ b/services/surfaceflinger/DroidloomReleaseQueue.h
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <set>
+#include <utility>
+#include <vector>
+
+namespace android {
+
+// Fence availability is a dependency, never a wait on a callback executor.
+// Value holds a real fence; readiness says nothing about whether it signalled.
+template <class Value>
+class DroidloomReleaseQueue {
+public:
+    using Key = std::pair<uint64_t, uint64_t>;
+    using Fences = std::map<Key, std::vector<Value>>;
+    using Callback = std::function<void(Fences)>;
+    struct Read {
+        Key key;
+        std::optional<Value> fence;
+        bool complete = false;
+    };
+
+    std::shared_ptr<Read> track(Key key) {
+        std::lock_guard lock(mMutex);
+        auto read = std::make_shared<Read>(Read{key, {}, false});
+        mReads[key].push_back(read);
+        return read;
+    }
+
+    // Completion may use NO_FENCE only when the host has proved all use ended
+    // (or a scene was explicitly rejected before any attachment).
+    bool publish(const std::shared_ptr<Read>& read, Value fence, bool complete = false) {
+        std::lock_guard dispatch(mDispatchMutex);
+        std::vector<std::function<void()>> ready;
+        {
+            std::lock_guard lock(mMutex);
+            if (read->complete || (read->fence && !complete)) return false;
+            if (!read->fence) read->fence = std::move(fence);
+            read->complete = complete;
+            auto it = mReads.find(read->key);
+            if (it != mReads.end() && std::all_of(it->second.begin(), it->second.end(),
+                                                [](const auto& r) { return r->complete; })) {
+                mReads.erase(it);
+            }
+            ready = takeReadyLocked();
+        }
+        for (auto& callback : ready) callback();
+        return true;
+    }
+
+    // Non-null lanes preserve completion order for a listener. Commit
+    // notifications and independent buffer releases use no lane.
+    void defer(const std::vector<Key>& keys, const void* lane, Callback callback) {
+        std::lock_guard dispatch(mDispatchMutex);
+        std::vector<std::function<void()>> ready;
+        {
+            std::lock_guard lock(mMutex);
+            Job job{{}, lane, std::move(callback)};
+            for (const auto& key : keys) {
+                auto it = mReads.find(key);
+                if (it != mReads.end()) job.reads.emplace(key, it->second);
+            }
+            mJobs.push_back(std::move(job));
+            ready = takeReadyLocked();
+        }
+        for (auto& action : ready) action();
+    }
+
+private:
+    struct Job {
+        std::map<Key, std::vector<std::shared_ptr<Read>>> reads;
+        const void* lane;
+        Callback callback;
+    };
+    std::vector<std::function<void()>> takeReadyLocked() {
+        std::vector<std::function<void()>> ready;
+        std::set<const void*> blocked;
+        for (auto it = mJobs.begin(); it != mJobs.end();) {
+            bool available = !it->lane || !blocked.contains(it->lane);
+            Fences fences;
+            for (const auto& [key, reads] : it->reads) {
+                for (const auto& read : reads) {
+                    if (!read->fence) { available = false; break; }
+                    fences[key].push_back(*read->fence);
+                }
+            }
+            if (!available) {
+                if (it->lane) blocked.insert(it->lane);
+                ++it;
+                continue;
+            }
+            ready.push_back([callback = std::move(it->callback), fences = std::move(fences)]() mutable {
+                callback(std::move(fences));
+            });
+            it = mJobs.erase(it);
+        }
+        return ready;
+    }
+    std::mutex mMutex;
+    // Preserve enqueue order across concurrent event/transaction threads.
+    // Callbacks only enqueue work; recursive entry remains safe for callers.
+    std::recursive_mutex mDispatchMutex;
+    std::map<Key, std::vector<std::shared_ptr<Read>>> mReads;
+    std::vector<Job> mJobs;
+};
+} // namespace android
