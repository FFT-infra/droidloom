+bool DroidloomNativeWindow::presentLayers(compositionengine::Output& output,
+                                                uint32_t width, uint32_t height, SurfaceFlinger& flinger) {
+    std::lock_guard lock(mMutex);
+    if (!mLayersAttempted) {
+        mLayersAttempted = true;
+        std::vector<uint8_t> payload;
+        appendU64(payload, mDisplay);
+        if (sendRecord(mSocket.get(), makeRecord(static_cast<Opcode>(12), payload, 0), -1) != NO_ERROR) return false;
+        ReceivedRecord response;
+        if (receiveRecord(mSocket.get(), &response) != NO_ERROR || response.length != 16 ||
+            readU16(response.bytes.data() + 6) != 13 || response.descriptors.size() != 2) return false;
+        mLayers = std::make_unique<DroidloomLayers>(std::move(response.descriptors[0]),
+                                                  std::move(response.descriptors[1]),
+                [weak = wp<SurfaceFlinger>::fromExisting(&flinger)] {
+                    if (auto owner = weak.promote()) owner->scheduleComposite(SurfaceFlinger::FrameHint::kNone);
+                });
+    }
+    return mLayers && mLayers->present(output, width, height);
+}
