+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <android-base/unique_fd.h>
+#include <gui/ITransactionCompletedListener.h>
+#include <ui/GraphicBuffer.h>
+
+#include <memory>
+#include <unordered_map>
+#include <functional>
+#include <vector>
+
+namespace android {
+namespace compositionengine {
+class Output;
+}
+
+// Release gates are keyed by the producer's actual buffer AND frame identity.
+// Only the host's completed Wayland read opens a gate. These waits are used
+// exclusively on Android's background transaction callback executor.
+bool droidloomAsyncReleasesEnabled();
+void waitDroidloomBufferReads(const ReleaseCallbackId& id);
+bool hasDroidloomBufferReads(const ReleaseCallbackId& id);
+
+class DroidloomLayers {
+   public:
+    DroidloomLayers(base::unique_fd requests, base::unique_fd events, std::function<void()> repaint);
+    ~DroidloomLayers();
+    void invalidate() { mScene.clear(); }
+    bool present(compositionengine::Output& output, uint32_t width, uint32_t height);
+
+   private:
+    bool presentFrame(compositionengine::Output& output, uint32_t width, uint32_t height);
+    std::vector<uint64_t> mScene;
+    struct State;
+    std::shared_ptr<State> mState;
+    base::unique_fd mRequests;
+    struct Cached {
+        sp<GraphicBuffer> buffer;
+        uint32_t format;
+    };
+    struct Last {
+        uint64_t buffer;
+        uint64_t frame;
+        uint64_t ticket;
+    };
+    std::unordered_map<uint64_t, Cached> mBuffers;
+    std::unordered_map<uint32_t, Last> mLayers;
+    uint64_t mNextTicket = 0;
+    bool mSubscribed = false;
+    bool transact(uint32_t opcode, const std::vector<uint8_t>& payload,
+                  const std::vector<int>& fds = {});
+};
+}  // namespace android
