+bool RenderSurface::prepareDroidloomHeadlessFrame(const sp<Fence>& readyFence) {
+    if (mTexture != nullptr) return false;
+    // Preserve HWC's real completion fence without acquiring a target or
+    // sending a discarded host frame. The private operation borrows the FD;
+    // SCM_RIGHTS duplicates it, and the ACK confirms Composer stored it.
+    const status_t handoff = mNativeWindow->perform(mNativeWindow.get(),
+            DroidloomNativeWindow::kCompleteHeadlessFrame, readyFence->get());
+    if (handoff != NO_ERROR) {
+        ALOGE("Droidloom bootstrap fence handoff failed: %d", handoff);
+        return false;
+    }
+    return true;
+}
+
+bool RenderSurface::queueDroidloomHeadlessFrame(float hdrSdrRatio) {
+    if (mTexture != nullptr) return false;
+    const status_t result = mDisplaySurface->advanceFrame(hdrSdrRatio);
+    if (result != NO_ERROR) {
+        ALOGE("[%s] failed pushing headless frame to HWC: %d", mDisplay.getName().c_str(), result);
+    }
+    if (!mDroidloomBufferlessReported) {
+        ALOGI("Droidloom bootstrap: bufferless frame completion active");
+        mDroidloomBufferlessReported = true;
+    }
+    return true;
+}
+
 void RenderSurface::onPresentDisplayCompleted() {
     mDisplaySurface->onFrameCommitted();
 }
