+void Output::prepareDroidloomHeadlessFrame() {
+    // HWC can present during validation, including frames with only device
+    // composition. Its fence must exist before prepareFrame(), not just when
+    // finishFrame() happens to queue a client target.
+    mDroidloomSkipBootstrapTarget = mDroidloomSkipBootstrapTarget &&
+            mDroidloomHeadlessFence && getState().isEnabled &&
+            mRenderSurface->prepareDroidloomHeadlessFrame(mDroidloomHeadlessFence);
+}
+
+bool Output::finishDroidloomHeadlessFrame() {
+    if (!mDroidloomSkipBootstrapTarget || !mDroidloomHeadlessFence ||
+        !getState().usesClientComposition) {
+        return false;
+    }
+
+    DroidloomTimingSpan queueTiming(DroidloomTimingStage::BootstrapQueue, mDroidloomTimingFrame);
+    const bool advanced = mRenderSurface->queueDroidloomHeadlessFrame(1.0f);
+    queueTiming.outcome(advanced);
+    queueTiming.stop();
+    if (!advanced) return false;
+
+    // No bootstrap buffer is read or written. Keep exactly the client LayerFEs
+    // selected by ordinary composition and their actual, possibly unsignaled,
+    // task-read fence. HWC present and release processing still run afterwards.
+    DroidloomTimingSpan requestsTiming(DroidloomTimingStage::BootstrapRequests,
+                                      mDroidloomTimingFrame, 0, getOutputLayerCount());
+    const auto dataspace = mDisplayColorProfile->hasWideColorGamut()
+            ? getState().dataspace : ui::Dataspace::UNKNOWN;
+    std::vector<LayerFE*> clientCompositionLayersFE;
+    static_cast<void>(generateClientCompositionRequests(
+            getCompositionEngine().getRenderEngine().supportsProtectedContent(),
+            dataspace, clientCompositionLayersFE));
+    requestsTiming.stop();
+    setExpensiveRenderingExpected(false);
+    for (auto* layer : clientCompositionLayersFE) {
+        layer->setWasClientComposed(mDroidloomHeadlessFence);
+    }
+    if (isPowerHintSessionEnabled() && !isPowerHintSessionGpuReportingEnabled()) {
+        setHintSessionGpuFence(std::make_unique<FenceTime>(
+                sp<Fence>::make(mDroidloomHeadlessFence->dup())));
+    }
+    return true;
+}
