+void ScreenCaptureOutput::setDroidloomTarget(
+        std::shared_ptr<renderengine::ExternalTexture> buffer) {
+    mDroidloomTarget = true;
+    static_cast<ScreenCaptureRenderSurface*>(getRenderSurface())->setBuffer(std::move(buffer));
+}
+
+ftl::Future<std::monostate> ScreenCaptureOutput::present(
+        const compositionengine::CompositionRefreshArgs& args) {
+    if (mDroidloomTarget) {
+        // prepare() has updated coverage; present() clears dirtyRegion. Export
+        // damage in target coordinates, never in Android desktop coordinates.
+        const auto& state = getState();
+        Region damage = getDirtyRegion();
+        bool samplesBehind = false;
+        for (const auto* outputLayer : getOutputLayersOrderedByZ()) {
+            const auto* layer = outputLayer->getLayerFE().getCompositionState();
+            // Normal physical displays receive buffer invalidation through
+            // SurfaceFlinger::invalidateLayerStack. Task outputs must include
+            // those content changes themselves even when geometry is stable.
+            const auto& snapshot =
+                    static_cast<const surfaceflinger::frontend::LayerSnapshot&>(*layer);
+            if (layer->contentDirty || !layer->surfaceDamage.isEmpty()) {
+                // Producer damage is buffer-local. Preserve it exactly for
+                // unscaled, uncropped buffers; otherwise damage the layer's
+                // visible coverage rather than guess its sampling footprint.
+                constexpr auto bufferUpdate = layer_state_t::eBufferChanged |
+                        layer_state_t::eSurfaceDamageRegionChanged;
+                const Rect bufferBounds = layer->buffer
+                        ? Rect(layer->buffer->getWidth(), layer->buffer->getHeight()) : Rect();
+                const bool simpleBuffer = layer->buffer && !snapshot.autoRefresh &&
+                        !(snapshot.clientChanges & (layer_state_t::CONTENT_DIRTY & ~bufferUpdate)) &&
+                        layer->surfaceDamage.getBounds().isValid() &&
+                        layer->geomBufferTransform == 0 &&
+                        !layer->geomBufferUsesDisplayInverseTransform &&
+                        layer->geomLayerBounds == bufferBounds.toFloatRect() &&
+                        (layer->geomContentCrop.isEmpty() || layer->geomContentCrop == bufferBounds) &&
+                        !(layer->geomLayerTransform.getType() & ~ui::Transform::TRANSLATE) &&
+                        layer->geomLayerTransform.tx() == std::floor(layer->geomLayerTransform.tx()) &&
+                        layer->geomLayerTransform.ty() == std::floor(layer->geomLayerTransform.ty());
+                damage.orSelf(simpleBuffer
+                        ? layer->geomLayerTransform.transform(layer->surfaceDamage)
+                                  .intersect(outputLayer->getState().visibleRegion)
+                        : outputLayer->getState().visibleRegion);
+            }
+            samplesBehind |= snapshot.drawShadows() || snapshot.hasBlur() ||
+                    snapshot.hasBorderSettings() || snapshot.hasBoxShadowSettings() ||
+                    snapshot.postProcessShader != nullptr || layer->isTextureSamplingBehind;
+        }
+        mDroidloomDamage = samplesBehind && !damage.isEmpty()
+                ? Region(state.displaySpace.getBoundsAsRect())
+                : state.transform.transform(damage).intersect(state.displaySpace.getBoundsAsRect());
+    }
+    return compositionengine::impl::Output::present(args);
+}
+
