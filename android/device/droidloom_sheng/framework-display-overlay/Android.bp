// Droidloom's Composer publishes one independent Android logical display for
// each top-level host window. Installing this as a vendor RRO keeps that
// display model intact even though the system partition is an official,
// immutable Android artifact.
runtime_resource_overlay {
    name: "DroidloomFrameworkDisplayOverlay",
    vendor: true,
    // The reusable Android framework comes from the pinned CI system image,
    // not this vendor-only source build. The image builder verifies and stages
    // its exact framework-res.apk at this bounded path before Soong runs.
    sdk_version: "core_platform",
    aaptflags: [
        "--auto-add-overlay",
        "-I vendor/droidloom/android/prebuilts/framework-res.apk",
    ],
}
