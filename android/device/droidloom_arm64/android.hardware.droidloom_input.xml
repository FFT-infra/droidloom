<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <!-- Denial routes touch and pointer gestures through Droidloom's targeted
         MotionEvent bridge. Physical input nodes remain private to the host.
         Declare the basic touch interface apps can use through that bridge;
         physical sensors, cameras and microphones are separate capabilities. -->
    <feature name="android.hardware.touchscreen" />
    <feature name="android.hardware.faketouch" />
</permissions>
