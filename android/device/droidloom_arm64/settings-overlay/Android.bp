// Defaults for settings Android creates on fresh data. Droidloom declares
// Bluetooth for application compatibility but has no controller behind it, so
// the stack must not try to enable one at first boot.
runtime_resource_overlay {
    name: "DroidloomSettingsOverlay",
    vendor: true,
    sdk_version: "core_platform",
    aaptflags: [
        "--auto-add-overlay",
        "-I vendor/droidloom/android/prebuilts/framework-res.apk",
    ],
}
