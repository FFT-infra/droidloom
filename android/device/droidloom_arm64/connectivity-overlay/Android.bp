// Android sees the cell veth as an ordinary Ethernet interface. A static
// point-to-point configuration avoids adding a DHCP server to the Linux host;
// the host supervisor owns the matching gateway and NAT policy.
runtime_resource_overlay {
    name: "DroidloomConnectivityOverlay",
    vendor: true,
    // The reusable Connectivity resources and framework come from the pinned
    // CI image, not this vendor-only source build. Auto-add the one declared
    // overlay resource while using the exact staged framework attribute IDs.
    sdk_version: "core_platform",
    aaptflags: [
        "--auto-add-overlay",
        "-I vendor/droidloom/android/prebuilts/framework-res.apk",
    ],
}
