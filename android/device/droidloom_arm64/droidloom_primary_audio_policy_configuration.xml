<!--
  Android requires a primary module while bootstrapping AudioFlinger. Both
  endpoints use BUS devices so AOSP's example AIDL implementation selects its
  timing-correct stub stream rather than opening ALSA or another host device.
-->
<module name="default" halVersion="3.0">
    <attachedDevices>
        <item>Droidloom Silent Output</item>
        <item>Droidloom Silent Input</item>
    </attachedDevices>
    <defaultOutputDevice>Droidloom Silent Output</defaultOutputDevice>
    <mixPorts>
        <mixPort name="droidloom silent output" role="source"
            flags="AUDIO_OUTPUT_FLAG_PRIMARY">
            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                samplingRates="48000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
        </mixPort>
        <mixPort name="droidloom silent input" role="sink">
            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                samplingRates="48000" channelMasks="AUDIO_CHANNEL_IN_MONO"/>
        </mixPort>
    </mixPorts>
    <devicePorts>
        <devicePort tagName="Droidloom Silent Output" type="AUDIO_DEVICE_OUT_BUS"
            role="sink" address="droidloom-silent-output"/>
        <devicePort tagName="Droidloom Silent Input" type="AUDIO_DEVICE_IN_BUS"
            role="source" address="droidloom-silent-input"/>
    </devicePorts>
    <routes>
        <route type="mix" sink="Droidloom Silent Output"
            sources="droidloom silent output"/>
        <route type="mix" sink="droidloom silent input"
            sources="Droidloom Silent Input"/>
    </routes>
</module>
