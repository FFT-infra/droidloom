 struct dri_driver {
 	int fd;
 	void *driver_handle;
@@ -192,54 +209,76 @@ struct dri_driver *dri_init(struct driver *drv, const char *dri_so_path, const c
 		return NULL;
 
 	char *node_name = drmGetRenderDeviceNameFromFd(drv_get_fd(drv));
-	if (!node_name)
