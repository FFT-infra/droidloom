 	/* Version 4 for createNewScreen2 */
 	if (!lookup_extension(dri->extensions, __DRI_DRI2, 4,
-			      (const __DRIextension **)&dri->dri2_extension))
+			      (const __DRIextension **)&dri->dri2_extension)) {
+		drv_loge("DRI driver %s has no compatible DRI2 extension\n", driver_suffix);
