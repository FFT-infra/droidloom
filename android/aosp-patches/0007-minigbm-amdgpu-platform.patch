diff --git a/amdgpu.c b/amdgpu.c
index be84519..b780aa8 100644
--- a/amdgpu.c
+++ b/amdgpu.c
@@ -365,6 +365,7 @@ static int amdgpu_init(struct driver *drv)
 	drmVersionPtr drm_version;
 	struct format_metadata metadata;
 	uint64_t use_flags = BO_USE_RENDER_MASK;
+	int ret;
 
 	priv = calloc(1, sizeof(struct amdgpu_priv));
 	if (!priv)
@@ -381,7 +382,9 @@ static int amdgpu_init(struct driver *drv)
 
 	drv->priv = priv;
 
-	if (query_dev_info(drv_get_fd(drv), &priv->dev_info)) {
+	ret = query_dev_info(drv_get_fd(drv), &priv->dev_info);
+	if (ret) {
+		drv_loge("AMDGPU_INFO_DEV_INFO failed: %d (%s)\n", ret, strerror(errno));
 		free(priv);
 		drv->priv = NULL;
 		return -ENODEV;
@@ -389,9 +392,8 @@ static int amdgpu_init(struct driver *drv)
 
 	priv->dri = dri_init(drv, DRI_PATH, "radeonsi");
 	if (!priv->dri) {
-		free(priv);
-		drv->priv = NULL;
-		return -ENODEV;
+		drv_loge("radeonsi DRI initialization failed from %s\n", DRI_PATH);
+		drv_logi("using native linear AMD GEM allocations without legacy DRI\n");
 	}
 
 	/* Continue on failure, as we can still succesfully map things without SDMA. */
@@ -444,6 +446,15 @@ static int amdgpu_init(struct driver *drv)
 				   BO_USE_HW_VIDEO_ENCODER | BO_USE_GPU_DATA_BUFFER |
 				   BO_USE_SENSOR_DIRECT_DATA);
 
+	/*
+	 * Mesa's Android dril target does not implement the legacy image-allocation
+	 * DRI ABI consumed below. Droidloom can still use minigbm's native AMD GEM
+	 * path with linear DMA-BUFs; all combinations registered above resolve to
+	 * TILE_TYPE_LINEAR and therefore never call through the absent DRI object.
+	 */
+	if (!priv->dri)
+		return 0;
+
 	/*
 	 * The following formats will be allocated by the DRI backend and may be potentially tiled.
 	 * Since format modifier support hasn't been implemented fully yet, it's not
@@ -514,7 +525,8 @@ static void amdgpu_close(struct driver *drv)
 	struct amdgpu_priv *priv = drv->priv;
 
 	sdma_finish(priv, drv_get_fd(drv));
-	dri_close(priv->dri);
+	if (priv->dri)
+		dri_close(priv->dri);
 	free(priv);
 
 	drv->priv = NULL;
@@ -662,6 +674,9 @@ static int amdgpu_create_bo_with_modifiers(struct bo *bo, uint32_t width, uint32
 	if (only_use_linear)
 		return amdgpu_create_bo_linear(bo, width, height, format, BO_USE_SCANOUT);
 
+	if (!priv->dri)
+		return -ENOTSUP;
+
 	return dri_bo_create_with_modifiers(priv->dri, bo, width, height, format, 0, modifiers,
 					    count);
 }
@@ -679,8 +694,14 @@ static int amdgpu_import_bo(struct bo *bo, struct drv_import_fd_data *data)
 		dri_tiling = combo->metadata.tiling != TILE_TYPE_LINEAR;
 	}
 
-	bo->meta.num_planes =
-	    dri_num_planes_from_modifier(priv->dri, data->format, data->format_modifier);
+	if (!priv->dri) {
+		/* Preserve explicit modifier metadata while PRIME imports the GEM object;
+		 * Mesa's Android EGL path consumes the modifier independently. */
+		bo->meta.num_planes = drv_num_planes_from_format(data->format);
+		return drv_prime_bo_import(bo, data);
+	}
+	bo->meta.num_planes =
+	    dri_num_planes_from_modifier(priv->dri, data->format, data->format_modifier);
 
 	if (dri_tiling)
 		return dri_bo_import(priv->dri, bo, data);
@@ -848,6 +869,8 @@ static size_t amdgpu_num_planes_from_modifier(struct driver *drv, uint32_t forma
 					      uint64_t modifier)
 {
 	struct amdgpu_priv *priv = drv->priv;
+	if (!priv->dri)
+		return drv_num_planes_from_format(format);
 	return dri_num_planes_from_modifier(priv->dri, format, modifier);
 }
 
