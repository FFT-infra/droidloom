+std::optional<uint32_t> getDmabufIdFromCodec2Handle(const C2Handle* handle) {
+    if (handle == nullptr) {
+        ALOGE("Codec2 graphic block has no handle.");
+        return std::nullopt;
+    }
+
+    // C2Handle is opaque. This helper unwraps both Gralloc and IGBA/AHardwareBuffer handles.
+    native_handle_t* nativeHandle = UnwrapNativeCodec2GrallocHandle(handle);
+    if (nativeHandle == nullptr) {
+        ALOGE("Failed to unwrap Codec2 graphic block handle.");
+        return std::nullopt;
+    }
+
+    std::optional<uint32_t> dmabufId;
+    if (nativeHandle->numFds <= 0) {
+        ALOGE("Unwrapped graphic block handle has no dma-buf fd.");
+    } else {
+        auto id = android::getDmabufId(nativeHandle->data[0]);
+        if (id) {
+            dmabufId = id.value();
+        }
+    }
+    // The unwrapped handle does not own the fds; delete the temporary wrapper only.
+    native_handle_delete(nativeHandle);
+    return dmabufId;
+}
+
