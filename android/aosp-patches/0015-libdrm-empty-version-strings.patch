diff --git a/xf86drm.c b/xf86drm.c
--- a/xf86drm.c
+++ b/xf86drm.c
@@ -1341,12 +1341,15 @@ static void drmCopyVersion(drmVersionPtr d, const drm_version_t *s)
 {
+    /* DRM drivers may advertise empty strings, leaving the kernel-version
+     * pointers NULL. Keep the public strings owned and NUL-terminated.
+     */
     d->version_major      = s->version_major;
     d->version_minor      = s->version_minor;
     d->version_patchlevel = s->version_patchlevel;
     d->name_len           = s->name_len;
-    d->name               = strdup(s->name);
+    d->name               = strdup(s->name ? s->name : "");
     d->date_len           = s->date_len;
-    d->date               = strdup(s->date);
+    d->date               = strdup(s->date ? s->date : "");
     d->desc_len           = s->desc_len;
-    d->desc               = strdup(s->desc);
+    d->desc               = strdup(s->desc ? s->desc : "");
 }
 
