diff --git a/v4l2/V4L2Device.cpp b/v4l2/V4L2Device.cpp
index 19601bc..1b677be 100644
--- a/v4l2/V4L2Device.cpp
+++ b/v4l2/V4L2Device.cpp
@@ -2295,6 +2295,26 @@ SupportedCapabilities V4L2Device::queryDecodingCapabilities(VideoCodec codec) {
             V4L2Device::Type::kDecoder, {V4L2Device::videoCodecToPixFmt(codec)});
     caps.defaultLevel = V4L2Device::getDefaultLevel(codec);
 
+    // Probe S_FMT on a disposable decoder fd before C2 allocates bitstream buffers. Some
+    // drivers return the requested size unchanged from TRY_FMT even when S_FMT later reports
+    // a larger required sizeimage (Iris reports 14 MiB for VP9 on sheng).
+    const uint32_t inputPixelFormat = V4L2Device::videoCodecToPixFmt(codec);
+    scoped_refptr<V4L2Device> formatProbe = V4L2Device::create();
+    if (formatProbe->open(Type::kDecoder, inputPixelFormat)) {
+        scoped_refptr<V4L2Queue> outputQueue =
+                formatProbe->getQueue(V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+        if (outputQueue) {
+            auto format = outputQueue->setFormat(inputPixelFormat, ui::Size(), 0, 0);
+            if (format && format->fmt.pix_mp.num_planes > 0) {
+                caps.maxInputBufferSize = format->fmt.pix_mp.plane_fmt[0].sizeimage;
+                if (caps.maxInputBufferSize > 0) {
+                    ALOGI("V4L2 decoder input sizeimage: fourcc=0x%08x size=%zu",
+                          inputPixelFormat, caps.maxInputBufferSize);
+                }
+            }
+        }
+    }
+
     return caps;
 }
 
