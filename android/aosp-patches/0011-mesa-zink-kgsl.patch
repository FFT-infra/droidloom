 static int
+zink_get_kgsl_device(const struct zink_screen *screen, uint32_t pdev_count,
+                     const VkPhysicalDevice *pdevs)
+{
+   int selected = -1;
+
+   for (uint32_t i = 0; i < pdev_count; ++i) {
+      VkPhysicalDeviceDriverProperties driver = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES,
+      };
+      VkPhysicalDeviceProperties2 props = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+         .pNext = &driver,
+      };
+      VKSCR(GetPhysicalDeviceProperties2)(pdevs[i], &props);
+      if (driver.driverID != VK_DRIVER_ID_MESA_TURNIP)
+         continue;
+
+      uint32_t count = 0;
+      if (VKSCR(EnumerateDeviceExtensionProperties)(pdevs[i], NULL, &count, NULL) != VK_SUCCESS)
+         return -1;
+      VkExtensionProperties *extensions = calloc(count, sizeof(*extensions));
+      if (!extensions)
+         return -1;
+      VkResult result = VKSCR(EnumerateDeviceExtensionProperties)(pdevs[i], NULL, &count, extensions);
+      bool drm = false, memory_fd = false, dmabuf = false, modifiers = false;
+      for (uint32_t j = 0; result == VK_SUCCESS && j < count; ++j) {
+         const char *name = extensions[j].extensionName;
+         drm |= !strcmp(name, VK_EXT_PHYSICAL_DEVICE_DRM_EXTENSION_NAME);
+         memory_fd |= !strcmp(name, VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME);
+         dmabuf |= !strcmp(name, VK_EXT_EXTERNAL_MEMORY_DMA_BUF_EXTENSION_NAME);
+         modifiers |= !strcmp(name, VK_EXT_IMAGE_DRM_FORMAT_MODIFIER_EXTENSION_NAME);
+      }
+      free(extensions);
+      if (result != VK_SUCCESS)
+         return -1;
+
+      /* Turnip's KGSL backend has no DRM identity. Its buffers can still be
+       * imported by the separate downstream msm_drm display device.
+       */
+      if (drm || !memory_fd || !dmabuf || !modifiers)
+         continue;
+      if (selected != -1)
+         return -1; /* Do not guess between multiple rendering devices. */
+      selected = i;
+   }
+   return selected;
+}
