+
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <vector>
+
+#include "../util/CameraBufferUsage.h"
+#include "../util/CpuYuvConversion.h"
+
+using android::companion::virtualcamera::cameraProducerUsage;
+
+using android::companion::virtualcamera::CpuYuvPlanes;
+using android::companion::virtualcamera::rgbaToCpuYuv420;
+using android::companion::virtualcamera::validCpuYuvSize;
+
+namespace {
+void require(bool ok, const char* expression, int line) {
+  if (!ok) {
+    std::fprintf(stderr, "FAIL line %d: %s\n", line, expression);
+    std::exit(1);
+  }
+}
+#define CHECK(condition) require((condition), #condition, __LINE__)
+
+constexpr uint8_t kPadding = 0xcc;
+struct Color {
+  uint8_t r, g, b;
+  int y, cb, cr;
+};
+constexpr std::array<Color, 6> kColors{{
+    {0, 0, 0, 0, 128, 128},
+    {255, 255, 255, 255, 128, 128},
+    {255, 0, 0, 76, 85, 255},
+    {0, 255, 0, 150, 44, 21},
+    {0, 0, 255, 29, 255, 107},
+    {64, 64, 64, 64, 128, 128},
+}};
+
+bool near(uint8_t actual, int expected) {
+  return std::abs(static_cast<int>(actual) - expected) <= 1;
+}
+
+std::vector<uint8_t> quadrants() {
+  std::vector<uint8_t> rgba(4 * 4 * 4);
+  const std::array<size_t, 4> colors{2, 3, 4, 1};
+  for (int row = 0; row < 4; ++row) {
+    for (int col = 0; col < 4; ++col) {
+      const Color color = kColors[colors[(row / 2) * 2 + col / 2]];
+      const size_t index = static_cast<size_t>(row * 4 + col) * 4;
+      rgba[index] = color.r;
+      rgba[index + 1] = color.g;
+      rgba[index + 2] = color.b;
+      rgba[index + 3] = 255;
+    }
+  }
+  return rgba;
+}
+
+void backendUsageSelection() {
+  // Android BufferUsage ABI values; the shared helper takes the real AIDL enum
+  // in both getHalStream and the hardware-buffer capability probe.
+  enum class Usage : uint64_t {
+    CPU_READ_OFTEN = 3,
+    CPU_WRITE_OFTEN = 0x30,
+    GPU_TEXTURE = 0x100,
+    GPU_RENDER_TARGET = 0x200,
+    VIDEO_ENCODER = 0x10000,
+    CAMERA_OUTPUT = 0x20000,
+  };
+  constexpr uint64_t render = static_cast<uint64_t>(Usage::GPU_RENDER_TARGET);
+  constexpr uint64_t camera = static_cast<uint64_t>(Usage::CAMERA_OUTPUT);
+  constexpr uint64_t write = static_cast<uint64_t>(Usage::CPU_WRITE_OFTEN);
+  const uint64_t consumer = static_cast<uint64_t>(Usage::GPU_TEXTURE) |
+                            static_cast<uint64_t>(Usage::VIDEO_ENCODER) |
+                            (uint64_t{1} << 40);
+  const auto requested = static_cast<Usage>(consumer);
+  const uint64_t cpu = cameraProducerUsage(requested, true);
+  CHECK((cpu & render) == 0);
+  CHECK(cpu == (consumer | camera | write));
+  const uint64_t gpu = cameraProducerUsage(requested, false);
+  CHECK((gpu & render) != 0);
+  CHECK(gpu == (consumer | camera | write | render));
+  // A consumer's explicit requirement must never be silently removed.
+  CHECK((cameraProducerUsage(static_cast<Usage>(consumer | render), true) &
+         render) != 0);
+  // Probe the same camera-output allocation path as an ImageReader stream.
+  const uint64_t probe = cameraProducerUsage(Usage::CPU_READ_OFTEN, true);
+  CHECK(probe == (3 | camera | write));
+  CHECK((probe & render) == 0);
+}
+
+void colorsAndFullRange() {
+  std::vector<uint8_t> scratch;
+  for (const auto& color : kColors) {
+    std::array<uint8_t, 16> rgba{};
+    for (size_t i = 0; i < rgba.size(); i += 4) {
+      rgba[i] = color.r;
+      rgba[i + 1] = color.g;
+      rgba[i + 2] = color.b;
+      rgba[i + 3] = 0;  // Alpha does not change camera color samples.
+    }
+    std::array<uint8_t, 6> out{};
+    CHECK(rgbaToCpuYuv420(rgba.data(), rgba.size(), 2, 2,
+                          {out.data(), out.data() + 4, out.data() + 5, 2, 1, 1},
+                          scratch));
+    for (size_t i = 0; i < 4; ++i) CHECK(near(out[i], color.y));
+    CHECK(near(out[4], color.cb));
+    CHECK(near(out[5], color.cr));
+  }
+}
+
+void rowOrderAndChannels() {
+  const auto rgba = quadrants();
+  std::array<uint8_t, 24> out{};
+  std::vector<uint8_t> scratch;
+  CHECK(rgbaToCpuYuv420(rgba.data(), rgba.size(), 4, 4,
+                        {out.data(), out.data() + 16, out.data() + 20, 4, 2, 1},
+                        scratch));
+  const std::array<size_t, 4> colors{2, 3, 4, 1};
+  for (size_t row = 0; row < 4; ++row) {
+    for (size_t col = 0; col < 4; ++col) {
+      CHECK(near(out[row * 4 + col],
+                 kColors[colors[(row / 2) * 2 + col / 2]].y));
+    }
+  }
+  for (size_t i = 0; i < 4; ++i) {
+    CHECK(near(out[16 + i], kColors[colors[i]].cb));
+    CHECK(near(out[20 + i], kColors[colors[i]].cr));
+  }
+}
+
+void planarPadding() {
+  const auto rgba = quadrants();
+  std::vector<uint8_t> y(7 * 4 + 8, kPadding);
+  std::vector<uint8_t> cb(5 * 2 + 8, kPadding);
+  std::vector<uint8_t> cr(5 * 2 + 8, kPadding);
+  std::vector<uint8_t> scratch;
+  CHECK(rgbaToCpuYuv420(rgba.data(), rgba.size(), 4, 4,
+                        {y.data(), cb.data(), cr.data(), 7, 5, 1}, scratch));
+  for (size_t i = 0; i < y.size(); ++i) {
+    if (i >= 7 * 4 || i % 7 >= 4) CHECK(y[i] == kPadding);
+  }
+  for (size_t i = 0; i < cb.size(); ++i) {
+    if (i >= 5 * 2 || i % 5 >= 2) {
+      CHECK(cb[i] == kPadding);
+      CHECK(cr[i] == kPadding);
+    }
+  }
+  CHECK(near(y[0], 76));
+  CHECK(near(y[2 * 7], 29));
+  CHECK(near(cb[0], 85));
+  CHECK(near(cr[5], 107));
+}
+
+void interleavedChroma() {
+  const auto rgba = quadrants();
+  for (const bool nv21 : {false, true}) {
+    std::vector<uint8_t> y(6 * 4 + 8, kPadding);
+    std::vector<uint8_t> uv(8 * 2 + 8, kPadding);
+    std::vector<uint8_t> scratch;
+    uint8_t* cb = uv.data() + (nv21 ? 1 : 0);
+    uint8_t* cr = uv.data() + (nv21 ? 0 : 1);
+    CHECK(rgbaToCpuYuv420(rgba.data(), rgba.size(), 4, 4,
+                          {y.data(), cb, cr, 6, 8, 2}, scratch));
+    const std::array<size_t, 4> colors{2, 3, 4, 1};
+    for (size_t i = 0; i < 4; ++i) {
+      const size_t offset = (i / 2) * 8 + (i % 2) * 2;
+      CHECK(near(cb[offset], kColors[colors[i]].cb));
+      CHECK(near(cr[offset], kColors[colors[i]].cr));
+    }
+    for (size_t i = 0; i < uv.size(); ++i) {
+      if (i >= 16 || i % 8 >= 4) CHECK(uv[i] == kPadding);
+    }
+  }
+}
+
+void invalidInputsDoNotWrite() {
+  const auto rgba = quadrants();
+  std::vector<uint8_t> output(32, kPadding);
+  std::vector<uint8_t> scratch;
+  const CpuYuvPlanes valid{output.data(), output.data() + 16,
+                            output.data() + 20, 4, 2, 1};
+  auto reject = [&](const uint8_t* input, size_t size, int w, int h,
+                    CpuYuvPlanes planes) {
+    CHECK(!rgbaToCpuYuv420(input, size, w, h, planes, scratch));
+    for (uint8_t byte : output) CHECK(byte == kPadding);
+  };
+  reject(nullptr, rgba.size(), 4, 4, valid);
+  reject(rgba.data(), rgba.size() - 1, 4, 4, valid);
+  for (const auto [w, h] : std::array<std::array<int, 2>, 5>{{
+           {0, 4}, {-2, 4}, {3, 4}, {4, 3}, {4096, 4098}}}) {
+    reject(rgba.data(), rgba.size(), w, h, valid);
+  }
+  auto bad = valid;
+  bad.y = nullptr;
+  reject(rgba.data(), rgba.size(), 4, 4, bad);
+  bad = valid;
+  bad.ystride = 3;
+  reject(rgba.data(), rgba.size(), 4, 4, bad);
+  bad = valid;
+  bad.cstride = 1;
+  reject(rgba.data(), rgba.size(), 4, 4, bad);
+  bad = valid;
+  bad.chromaStep = 2;
+  reject(rgba.data(), rgba.size(), 4, 4, bad);
+  bad = valid;
+  bad.chromaStep = 0;
+  reject(rgba.data(), rgba.size(), 4, 4, bad);
+  bad = valid;
+  bad.ystride = std::numeric_limits<size_t>::max();
+  reject(rgba.data(), rgba.size(), 4, 4, bad);
+  bad = valid;
+  bad.cstride = std::numeric_limits<size_t>::max();
+  reject(rgba.data(), rgba.size(), 4, 4, bad);
+}
+
+void boundedSizesAndScratchReuse() {
+  CHECK(validCpuYuvSize(640, 480));
+  CHECK(validCpuYuvSize(4096, 4096));
+  CHECK(!validCpuYuvSize(4096, 4098));
+  CHECK(!validCpuYuvSize(std::numeric_limits<int>::max(), 2));
+  auto rgba = quadrants();
+  std::array<uint8_t, 24> out{};
+  std::vector<uint8_t> scratch;
+  CHECK(rgbaToCpuYuv420(rgba.data(), rgba.size(), 4, 4,
+                        {out.data(), out.data() + 16, out.data() + 20, 4, 2, 1},
+                        scratch));
+  const auto* allocation = scratch.data();
+  CHECK(rgbaToCpuYuv420(rgba.data(), rgba.size(), 2, 2,
+                        {out.data(), out.data() + 4, out.data() + 5, 2, 1, 1},
+                        scratch));
+  CHECK(scratch.data() == allocation);
+}
+}  // namespace
+
+int main() {
+  const std::array<void (*)(), 7> tests{
+      backendUsageSelection, colorsAndFullRange, rowOrderAndChannels,
+      planarPadding, interleavedChroma, invalidInputsDoNotWrite,
+      boundedSizesAndScratchReuse};
+  for (auto test : tests) test();
+  std::puts("CPU YUV conversion and usage: 7 tests passed");
+}
