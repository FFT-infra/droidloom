+#ifndef ANDROID_COMPANION_VIRTUALCAMERA_CAMERABUFFERUSAGE_H
+#define ANDROID_COMPANION_VIRTUALCAMERA_CAMERABUFFERUSAGE_H
+
+#include <cstdint>
+
+namespace android::companion::virtualcamera {
+
+// Shared by the capability probe and HalStream advertisement. Preserve the
+// consumer's requirements, but only request GPU rendering for the GPU backend.
+template <typename BufferUsage>
+constexpr uint64_t cameraProducerUsage(BufferUsage consumerUsage, bool cpuYuv) {
+  return static_cast<uint64_t>(consumerUsage) |
+         static_cast<uint64_t>(BufferUsage::CAMERA_OUTPUT) |
+         static_cast<uint64_t>(BufferUsage::CPU_WRITE_OFTEN) |
+         (cpuYuv ? 0 : static_cast<uint64_t>(BufferUsage::GPU_RENDER_TARGET));
+}
+
+}  // namespace android::companion::virtualcamera
+
+#endif  // ANDROID_COMPANION_VIRTUALCAMERA_CAMERABUFFERUSAGE_H
