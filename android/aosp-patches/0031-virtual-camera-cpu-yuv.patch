+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#ifndef ANDROID_COMPANION_VIRTUALCAMERA_CPUYUVCONVERSION_H
+#define ANDROID_COMPANION_VIRTUALCAMERA_CPUYUVCONVERSION_H
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+#include "libyuv/convert_from_argb.h"
+
+namespace android::companion::virtualcamera {
+
+// Keep readback and conversion allocations bounded independently of gralloc.
+constexpr size_t kMaxCpuYuvPixels = 4096U * 4096U;
+
+inline bool validCpuYuvSize(int width, int height) {
+  return width > 0 && height > 0 && !(width & 1) && !(height & 1) &&
+         static_cast<size_t>(width) <=
+             kMaxCpuYuvPixels / static_cast<size_t>(height);
+}
+
+struct CpuYuvPlanes {
+  uint8_t* y;
+  uint8_t* cb;
+  uint8_t* cr;
+  size_t ystride;
+  size_t cstride;
+  size_t chromaStep;
+};
+
+// Rows have the same order as glReadPixels and the existing YUV framebuffer.
+// SurfaceTexture's transform is applied while drawing, not a second time here.
+inline bool rgbaToCpuYuv420(const uint8_t* rgba, size_t rgbaBytes, int width,
+                           int height, const CpuYuvPlanes& out,
+                           std::vector<uint8_t>& scratch) {
+  if (!validCpuYuvSize(width, height) || rgba == nullptr || out.y == nullptr ||
+      out.cb == nullptr || out.cr == nullptr ||
+      (out.chromaStep != 1 && out.chromaStep != 2)) {
+    return false;
+  }
+  const size_t w = static_cast<size_t>(width);
+  const size_t h = static_cast<size_t>(height);
+  const size_t pixels = w * h;
+  const size_t chromaWidth = w / 2;
+  const size_t chromaHeight = h / 2;
+  const size_t chromaRowBytes = (chromaWidth - 1) * out.chromaStep + 1;
+  const size_t maxOffset = std::numeric_limits<ptrdiff_t>::max();
+  if (rgbaBytes < pixels * 4 || out.ystride < w ||
+      out.cstride < chromaRowBytes || out.ystride > maxOffset / h ||
+      out.cstride > maxOffset / chromaHeight) {
+    return false;
+  }
+
+  scratch.resize(pixels + pixels / 2);
+  uint8_t* y = scratch.data();
+  uint8_t* cb = y + pixels;
+  uint8_t* cr = cb + pixels / 4;
+  // libyuv ABGR names register order: little-endian memory is R,G,B,A.
+  // J420 preserves the full-range BT.601 conversion used by the GPU shader.
+  if (libyuv::ABGRToJ420(rgba, width * 4, y, width, cb, width / 2, cr,
+                        width / 2, width, height) != 0) {
+    return false;
+  }
+  for (size_t row = 0; row < h; ++row) {
+    std::memcpy(out.y + row * out.ystride, y + row * w, w);
+  }
+  for (size_t row = 0; row < chromaHeight; ++row) {
+    for (size_t col = 0; col < chromaWidth; ++col) {
+      out.cb[row * out.cstride + col * out.chromaStep] =
+          cb[row * chromaWidth + col];
+      out.cr[row * out.cstride + col * out.chromaStep] =
+          cr[row * chromaWidth + col];
+    }
+  }
+  return true;
+}
+
+}  // namespace android::companion::virtualcamera
+
+#endif  // ANDROID_COMPANION_VIRTUALCAMERA_CPUYUVCONVERSION_H
