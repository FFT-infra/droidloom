diff --git a/v4l2/V4L2Decoder.cpp b/v4l2/V4L2Decoder.cpp
index 182c196..76d4891 100644
--- a/v4l2/V4L2Decoder.cpp
+++ b/v4l2/V4L2Decoder.cpp
@@ -31,6 +31,44 @@ namespace {
 // Extra buffers for transmitting in the whole video pipeline.
 constexpr size_t kNumExtraOutputBuffers = 4;
 
+// AV1 low-overhead bitstreams carry frames in OBU_FRAME or OBU_FRAME_HEADER.
+// The framework seeks to sync samples; this detects frame-bearing work so the
+// initial output-format handshake does not mistake AV1 CSD for an empty stream.
+bool containsAv1FrameObu(const uint8_t* data, size_t size) {
+    size_t offset = 0;
+    while (offset < size) {
+        const uint8_t header = data[offset++];
+        if ((header & 0x80) != 0 || (header & 0x01) != 0) return false;
+        const uint8_t type = (header >> 3) & 0x0f;
+        const bool hasExtension = (header & 0x04) != 0;
+        const bool hasSize = (header & 0x02) != 0;
+        if (hasExtension) {
+            if (offset >= size) return false;
+            ++offset;
+        }
+        uint64_t payloadSize = size - offset;
+        if (hasSize) {
+            payloadSize = 0;
+            unsigned int shift = 0;
+            bool terminated = false;
+            for (unsigned int i = 0; i < 8 && offset < size; ++i) {
+                const uint8_t byte = data[offset++];
+                payloadSize |= static_cast<uint64_t>(byte & 0x7f) << shift;
+                if ((byte & 0x80) == 0) {
+                    terminated = true;
+                    break;
+                }
+                shift += 7;
+            }
+            if (!terminated) return false;
+        }
+        if (type == 3 || type == 6) return true;
+        if (payloadSize > size - offset) return false;
+        offset += static_cast<size_t>(payloadSize);
+    }
+    return false;
+}
