     C2ReadView view = input.map().get();
     const uint8_t* pos = view.data();
@@ -56,6 +94,10 @@ bool waitForDRC(const C2ConstLinearBlock& input, std::optional<VideoCodec> codec
     case VideoCodec::VP8:
         // 0 - key frame; 1 - interframe;
         return ((pos[0] & kVP8FrameTypeMask) == 0);
+    case VideoCodec::AV1:
+        // The extractor starts a decoder at a sync sample. AV1 low-overhead
+        // samples carry the frame in OBU_FRAME or OBU_FRAME_HEADER.
+        return containsAv1FrameObu(pos, view.capacity());
     }
 
     return false;
