+        "EngineConfigXmlConverter.cpp",
+        "Module.cpp",
+        "ModulePrimary.cpp",
+        "SoundDose.cpp",
+        "Stream.cpp",
+        "Telephony.cpp",
+        "XsdcConversion.cpp",
+        "alsa/Mixer.cpp",
+        "alsa/StreamAlsa.cpp",
+        "alsa/StreamAlsaBase.cpp",
+        "alsa/StreamAlsaMonoPipe.cpp",
+        "alsa/UtilsAlsa.cpp",
+        "primary/PrimaryMixer.cpp",
+        "primary/StreamPrimary.cpp",
+        "stub/ApeHeader.cpp",
+        "stub/DriverStubImpl.cpp",
+        "stub/MpegAudioHeader.cpp",
+        "stub/StreamMmapStub.cpp",
+        "stub/StreamOffloadStub.cpp",
+        "stub/StreamStub.cpp",
+    ],
+    generated_sources: [
+        "audio_policy_capengine_configuration_aidl_default",
+        "audio_policy_configuration_aidl_default",
+        "audio_policy_engine_configuration_aidl_default",
