+// BPF helpers report TGIDs in the initial PID namespace. Android normally
+// runs there, but a Droidloom cell's getpid() is namespace-local. Ask an
+// unattached, three-instruction BPF program for the same identity used by
+// netd.c's is_netd(); keep its root/TGID checks unchanged.
+static Result<uint32_t> netdBpfPid() {
+    if (getenv("DROIDLOOM_CELL") == nullptr) return static_cast<uint32_t>(getpid());
+
+    const bpf_insn insns[] = {
+        {.code = BPF_JMP | BPF_CALL, .dst_reg = 0, .src_reg = 0, .off = 0,
+         .imm = BPF_FUNC_get_current_pid_tgid},
+        {.code = BPF_ALU64 | BPF_RSH | BPF_K, .dst_reg = BPF_REG_0, .src_reg = 0,
+         .off = 0, .imm = 32},
+        {.code = BPF_JMP | BPF_EXIT, .dst_reg = 0, .src_reg = 0, .off = 0, .imm = 0},
+    };
+    static constexpr char license[] = "Apache 2.0";
+    union bpf_attr load = {};
+    load.prog_type = BPF_PROG_TYPE_SYSCALL;
+    load.prog_flags = BPF_F_SLEEPABLE;
+    load.insn_cnt = sizeof(insns) / sizeof(insns[0]);
+    load.insns = reinterpret_cast<uint64_t>(insns);
+    load.license = reinterpret_cast<uint64_t>(license);
+    unique_fd prog(syscall(__NR_bpf, BPF_PROG_LOAD, &load, sizeof(load)));
+    if (!prog.ok()) return Error(errno) << "Loading netd BPF PID query";
+
+    union bpf_attr run = {};
+    run.test.prog_fd = prog.get();
+    if (syscall(__NR_bpf, BPF_PROG_TEST_RUN, &run, sizeof(run))) {
+        return Error(errno) << "Running netd BPF PID query";
+    }
+    if (!run.test.retval) return Error() << "BPF returned an invalid netd PID";
+    ALOGI("Droidloom netd PID: namespace=%d BPF=%u", getpid(), run.test.retval);
+    return run.test.retval;
+}
