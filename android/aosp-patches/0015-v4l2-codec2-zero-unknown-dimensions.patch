diff --git a/v4l2/V4L2Device.cpp b/v4l2/V4L2Device.cpp
--- a/v4l2/V4L2Device.cpp
+++ b/v4l2/V4L2Device.cpp
@@ -71,6 +71,9 @@ struct v4l2_format buildV4L2Format(const enum v4l2_buf_type type, uint32_t fourcc,
     format.type = type;
     format.fmt.pix_mp.pixelformat = fourcc;
-    format.fmt.pix_mp.width = size.width;
-    format.fmt.pix_mp.height = size.height;
+    // V4L2 represents unknown dimensions as 0. ui::Size uses negative values for
+    // unknown, so casting them directly to uint32_t produces UINT32_MAX. Drivers
+    // that align dimensions (such as qcom-iris) can overflow on that value.
+    format.fmt.pix_mp.width = size.width < 0 ? 0u : static_cast<uint32_t>(size.width);
+    format.fmt.pix_mp.height = size.height < 0 ? 0u : static_cast<uint32_t>(size.height);
     format.fmt.pix_mp.num_planes = V4L2Device::getNumPlanesOfV4L2PixFmt(fourcc);
     format.fmt.pix_mp.plane_fmt[0].sizeimage = buffer_size;
