@@ -100,9 +100,16 @@ C2R DecodeInterface::MergedColorAspectsSetter(bool /* mayBlock */,
 
 // static
 C2R DecodeInterface::MaxInputBufferSizeCalculator(
-        bool /* mayBlock */, C2P<C2StreamMaxBufferSizeInfo::input>& me,
+        bool /* mayBlock */, const C2P<C2StreamMaxBufferSizeInfo::input>& old,
+        C2P<C2StreamMaxBufferSizeInfo::input>& me,
         const C2P<C2StreamPictureSizeInfo::output>& size) {
-    size_t calculatedSize = calculateInputBufferSize(size.v.width * size.v.height);
+    // The bitstream buffer must be at least as large as the sizeimage the V4L2 driver reports
+    // for its OUTPUT queue; queryDecodingCapabilities() probes that size into this parameter's
+    // default. CCodec forwards the client's max-input-size here, so the previous value is kept
+    // as a floor: a client may ask for a larger buffer, but the driver rejects a smaller one at
+    // QBUF instead of decoding it.
+    size_t calculatedSize = std::max(calculateInputBufferSize(size.v.width * size.v.height),
+                                     static_cast<size_t>(old.v.value));
 
     if (me.v.value < calculatedSize) me.set().value = calculatedSize;
 
