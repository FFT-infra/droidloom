+#include "core-impl/DriverStubImpl.h"
+
+namespace aidl::android::hardware::audio::core {
+
+// Sends and receives audio streams with Droidloom's host audio bridge.
+//
+// The supervisor mounts the host endpoints into the cell, and the host end
+// renders or captures the bytes on the session sound server. The endpoint carries
+// the samples with no header and no conversion, so transfer() writes or reads
+// exactly the buffer it is given.
+//
+// Timing stays DriverStubImpl's: a transfer that waits is the pacing,
+// and a sink/source that cannot take or supply the data within the timeout costs those
+// frames instead of stalling Android's audio worker. With no endpoint present
+// the driver is the stub, so a cell without the bridge keeps its silent
+// but correctly paced behavior.
+class DriverSocketImpl : public DriverStubImpl {
+  public:
+    explicit DriverSocketImpl(const StreamContext& context);
+    DriverSocketImpl(const StreamContext& context, std::string path);
+
+    ::android::status_t start() override;
+    ::android::status_t standby() override;
+    ::android::status_t transfer(void* buffer, size_t frameCount, size_t* actualFrameCount,
+                                 int32_t* latencyMs) override;
+    void shutdown() override;
+
+  private:
+    // Longest one transfer may wait for the endpoint.
+    static constexpr int64_t kSendTimeoutUs = 100000;
+    // Endpoint exposed inside the cell unless a property overrides it.
+    static constexpr const char* kDefaultPath = "/dev/socket/droidloom/audio";
+    static constexpr const char* kPathProperty = "persist.vendor.droidloom.audio.socket";
+    static constexpr const char* kDefaultInPath = "/dev/socket/droidloom/audio_in";
+    static constexpr const char* kInPathProperty = "persist.vendor.droidloom.audio_in.socket";
+
+    static std::string defaultPath(bool isInput);
+
+    bool connect();
+    void disconnect();
+    // Writes as much of one buffer as the endpoint takes within the timeout and
+    // returns the bytes accepted from it.
+    size_t sendBuffer(const void* buffer, size_t byteCount);
+    // Reads as much of one buffer as the endpoint supplies within the timeout.
+    size_t receiveBuffer(void* buffer, size_t byteCount);
+
+    const std::string mPath;
+    int mFd = -1;
+    // Bytes the endpoint refused when a short write ended inside a frame. They
+    // are sent before anything newer, so the sink's stream never loses its
+    // frame alignment.
+    std::vector<uint8_t> mCarry;
+    bool mLoggedStall = false;
+};
+
+}  // namespace aidl::android::hardware::audio::core
