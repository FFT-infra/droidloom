+
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstring>
+#include <utility>
+
+#define LOG_TAG "AHAL_DriverSocket"
+#include <Log.h>
+#include <android-base/properties.h>
+
+#include "core-impl/DriverSocketImpl.h"
+
+namespace aidl::android::hardware::audio::core {
+
+// static
+std::string DriverSocketImpl::defaultPath(bool isInput) {
+    if (isInput) {
+        return ::android::base::GetProperty(kInPathProperty, kDefaultInPath);
+    }
+    return ::android::base::GetProperty(kPathProperty, kDefaultPath);
+}
+
+DriverSocketImpl::DriverSocketImpl(const StreamContext& context)
+    : DriverSocketImpl(context, defaultPath(context.isInput())) {}
+
+DriverSocketImpl::DriverSocketImpl(const StreamContext& context, std::string path)
+    : DriverStubImpl(context), mPath(std::move(path)) {}
+
+bool DriverSocketImpl::connect() {
+    if (mFd >= 0) {
+        return true;
+    }
+    if (mPath.size() >= sizeof(sockaddr_un::sun_path)) {
+        LOG(ERROR) << __func__ << ": endpoint path is too long: " << mPath;
+        return false;
+    }
+    const int fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (fd < 0) {
+        LOG(ERROR) << __func__ << ": cannot create the endpoint socket: " << strerror(errno);
+        return false;
+    }
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    std::memcpy(address.sun_path, mPath.c_str(), mPath.size());
+    if (::connect(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) < 0) {
+        const int error = errno;
+        ::close(fd);
+        // A cell whose host end is absent stays silent, but keeps running.
+        LOG(WARNING) << __func__ << ": " << mPath << " is not available: " << strerror(error);
+        return false;
+    }
+    timeval timeout;
+    timeout.tv_sec = kSendTimeoutUs / 1000000;
+    timeout.tv_usec = kSendTimeoutUs % 1000000;
+    const int opt = mIsInput ? SO_RCVTIMEO : SO_SNDTIMEO;
+    if (::setsockopt(fd, SOL_SOCKET, opt, &timeout, sizeof(timeout)) < 0) {
+        LOG(WARNING) << __func__ << ": cannot bound the timeout: " << strerror(errno);
+    }
+    mFd = fd;
+    mLoggedStall = false;
+    LOG(INFO) << __func__ << ": " << (mIsInput ? "capturing " : "sending ") << mSampleRate
+              << " Hz, " << mFrameSizeBytes << "-byte frames "
+              << (mIsInput ? "from " : "to ") << mPath;
+    return true;
+}
+
+void DriverSocketImpl::disconnect() {
+    // A carry belongs to the connection that produced it.
+    mCarry.clear();
+    if (mFd < 0) {
+        return;
+    }
+    // Closing the last writer is what tells the host bridge the stream ended.
+    ::close(mFd);
+    mFd = -1;
+}
+
+size_t DriverSocketImpl::sendBuffer(const void* buffer, size_t byteCount) {
+    const auto* bytes = static_cast<const uint8_t*>(buffer);
+    // Whatever a short write left behind belongs to an earlier frame and goes out
+    // first, so the sink never sees the stream out of order.
+    if (!mCarry.empty()) {
+        const ssize_t written = ::write(mFd, mCarry.data(), mCarry.size());
+        if (written > 0) {
+            mCarry.erase(mCarry.begin(),
+                         mCarry.begin() + static_cast<std::ptrdiff_t>(written));
+        } else if (written < 0 && errno != EINTR && errno != EAGAIN && errno != EWOULDBLOCK) {
+            LOG(WARNING) << __func__ << ": " << mPath << " failed: " << strerror(errno);
+            disconnect();
+            return 0;
+        }
+        if (!mCarry.empty()) {
+            // The sink has not caught up; this buffer is an underrun.
+            return 0;
+        }
+    }
+    size_t offset = 0;
+    while (offset < byteCount && mFd >= 0) {
+        const ssize_t written = ::write(mFd, bytes + offset, byteCount - offset);
+        if (written > 0) {
+            offset += static_cast<size_t>(written);
+            continue;
+        }
+        if (written < 0 && errno == EINTR) {
+            continue;
+        }
+        const int error = written < 0 ? errno : 0;
+        const size_t partial = offset % mFrameSizeBytes;
+        if (partial != 0) {
+            mCarry.assign(bytes + offset, bytes + offset + (mFrameSizeBytes - partial));
+        }
+        if (error != 0 && error != EAGAIN && error != EWOULDBLOCK) {
+            LOG(WARNING) << __func__ << ": " << mPath << " failed: " << strerror(error);
+            disconnect();
+        } else if (!mLoggedStall) {
+            mLoggedStall = true;
+            // Dropping is what an underrun sounds like; holding Android's audio
+            // worker until the sink recovers is not an option.
+            LOG(WARNING) << __func__ << ": " << mPath << " is behind; dropping frames";
+        }
+        break;
+    }
+    return offset;
+}
+
+size_t DriverSocketImpl::receiveBuffer(void* buffer, size_t byteCount) {
+    auto* bytes = static_cast<uint8_t*>(buffer);
+    size_t offset = 0;
+    while (offset < byteCount && mFd >= 0) {
+        const ssize_t count = ::read(mFd, bytes + offset, byteCount - offset);
+        if (count > 0) {
+            offset += static_cast<size_t>(count);
+            continue;
+        }
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        const int error = count < 0 ? errno : 0;
+        if (error != 0 && error != EAGAIN && error != EWOULDBLOCK) {
+            LOG(WARNING) << __func__ << ": " << mPath << " failed: " << strerror(error);
+            disconnect();
+        }
+        break;
+    }
+    if (offset < byteCount) {
+        std::memset(bytes + offset, 0, byteCount - offset);
+    }
+    return offset;
+}
+
+::android::status_t DriverSocketImpl::start() {
+    connect();
+    return DriverStubImpl::start();
+}
+
+::android::status_t DriverSocketImpl::standby() {
+    // An idle stream holds the bridge's single stream slot, and a host player
+    // that exists to render silence is worse than none.
+    disconnect();
+    return DriverStubImpl::standby();
+}
+
+::android::status_t DriverSocketImpl::transfer(void* buffer, size_t frameCount,
+                                               size_t* actualFrameCount, int32_t* latencyMs) {
+    if (mFd >= 0) {
+        if (!mIsInput) {
+            sendBuffer(buffer, frameCount * mFrameSizeBytes);
+        } else {
+            receiveBuffer(buffer, frameCount * mFrameSizeBytes);
+            if (actualFrameCount != nullptr) {
+                *actualFrameCount = frameCount;
+            }
+            if (latencyMs != nullptr) {
+                *latencyMs = 0;
+            }
+            return ::android::OK;
+        }
+    }
+    // A write that waited for the sink has already consumed the buffer's
+    // duration, and the stub's own accounting notices that and adds nothing.
+    return DriverStubImpl::transfer(buffer, frameCount, actualFrameCount, latencyMs);
+}
+
+void DriverSocketImpl::shutdown() {
+    disconnect();
+    DriverStubImpl::shutdown();
+}
+
+}  // namespace aidl::android::hardware::audio::core
