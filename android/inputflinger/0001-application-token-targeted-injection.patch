 namespace android::inputdispatcher {
 
+namespace {
+
+// Only Droidloom-targeted stylus injection uses this reserved device range.
+// Preserve its independent stream alongside Droidloom's injected touchscreen
+// and other targeted stylus tools, even on builds that disable the general
+// multi-device same-window feature flag.
+bool isDroidloomParallelVirtualStream(DeviceId firstId, uint32_t firstSource,
+                                      DeviceId secondId, uint32_t secondSource) {
+    const auto isDroidloomStylus = [](DeviceId id, uint32_t source) {
+        return id <= DROIDLOOM_STYLUS_DEVICE_ID_BASE &&
+                id >= DROIDLOOM_STYLUS_DEVICE_ID_BASE - MAX_POINTER_ID &&
+                isFromSource(source, AINPUT_SOURCE_STYLUS);
+    };
+    const auto isInjectedTouch = [](DeviceId id, uint32_t source) {
+        return id == VIRTUAL_KEYBOARD_ID && isFromSource(source, AINPUT_SOURCE_TOUCHSCREEN);
+    };
+    const bool firstStylus = isDroidloomStylus(firstId, firstSource);
+    const bool secondStylus = isDroidloomStylus(secondId, secondSource);
+    return firstId != secondId &&
+            ((firstStylus && (secondStylus || isInjectedTouch(secondId, secondSource))) ||
+             (secondStylus && isInjectedTouch(firstId, firstSource)));
+}
