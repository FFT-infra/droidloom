+sp<WindowInfoHandle> InputDispatcher::DispatcherWindowInfo::findWindowByApplicationToken(
+        ui::LogicalDisplayId displayId, const sp<IBinder>& targetApplicationToken) const {
+    for (const sp<WindowInfoHandle>& windowHandle : getWindowHandlesForDisplay(displayId)) {
+        const WindowInfo& info = *windowHandle->getInfo();
