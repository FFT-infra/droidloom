+status_t InputManager::onTransact(uint32_t code, const Parcel& data, Parcel* reply,
+                                  uint32_t flags) {
+    static constexpr uint32_t kDroidloomInjectToApplicationTransaction = 0x00444c02;
+    if (code != kDroidloomInjectToApplicationTransaction) {
+        return BnInputFlinger::onTransact(code, data, reply, flags);
+    }
+
+    CHECK_INTERFACE(android::os::IInputFlinger, data, reply);
+    const uid_t uid = IPCThreadState::self()->getCallingUid();
+    if (uid != AID_ROOT && uid != AID_SYSTEM) {
+        ALOGE("Permission Denial: Droidloom targeted input from uid=%d", uid);
+        return PERMISSION_DENIED;
+    }
+    if (reply == nullptr) {
+        return BAD_VALUE;
+    }
+
+    sp<IBinder> targetApplicationToken;
+    status_t status = data.readStrongBinder(&targetApplicationToken);
+    int32_t mode;
+    status = status == OK ? data.readInt32(&mode) : status;
+    int32_t eventType;
+    status = status == OK ? data.readInt32(&eventType) : status;
+    if (status != OK || targetApplicationToken == nullptr ||
+        mode != static_cast<int32_t>(android::os::InputEventInjectionSync::NONE)) {
+        return BAD_VALUE;
+    }
+
+    std::unique_ptr<InputEvent> event;
+    if (eventType == 1) {
+        auto motionEvent = std::make_unique<MotionEvent>();
+        status = motionEvent->readFromParcel(const_cast<Parcel*>(&data));
+        event = std::move(motionEvent);
+    } else if (eventType == 2) {
+        auto keyEvent = std::make_unique<KeyEvent>();
+        status = readDroidloomKeyEvent(data, keyEvent.get());
+        event = std::move(keyEvent);
+    } else {
+        return BAD_VALUE;
+    }
+    if (status != OK || data.dataAvail() != 0) {
+        return BAD_VALUE;
+    }
+
+    auto* dispatcher = static_cast<inputdispatcher::InputDispatcher*>(mDispatcher.get());
+    const android::os::InputEventInjectionResult result =
+            dispatcher->injectInputEventToApplication(
+                    event.get(), std::nullopt, android::os::InputEventInjectionSync::NONE,
+                    std::chrono::milliseconds(30'000), POLICY_FLAG_DISABLE_KEY_REPEAT,
+                    targetApplicationToken);
+    status = reply->writeNoException();
+    return status == OK
+            ? reply->writeBool(result == android::os::InputEventInjectionResult::SUCCEEDED)
+            : status;
+}
