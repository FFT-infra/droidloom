+status_t readDroidloomKeyEvent(const Parcel& parcel, KeyEvent* event) {
+    int32_t id;
+    int32_t deviceId;
+    uint32_t source;
+    int32_t displayId;
+    std::optional<std::vector<uint8_t>> serializedHmac;
+    int32_t action;
+    int32_t keyCode;
+    int32_t repeatCount;
+    int32_t metaState;
+    int32_t scanCode;
+    int32_t eventFlags;
+    int64_t downTime;
+    int64_t eventTime;
+    std::optional<String16> characters;
+
+    status_t status = parcel.readInt32(&id);
+    status = status == OK ? parcel.readInt32(&deviceId) : status;
+    status = status == OK ? parcel.readUint32(&source) : status;
+    status = status == OK ? parcel.readInt32(&displayId) : status;
+    status = status == OK ? parcel.readByteVector(&serializedHmac) : status;
+    status = status == OK ? parcel.readInt32(&action) : status;
+    status = status == OK ? parcel.readInt32(&keyCode) : status;
+    status = status == OK ? parcel.readInt32(&repeatCount) : status;
+    status = status == OK ? parcel.readInt32(&metaState) : status;
+    status = status == OK ? parcel.readInt32(&scanCode) : status;
+    status = status == OK ? parcel.readInt32(&eventFlags) : status;
+    status = status == OK ? parcel.readInt64(&downTime) : status;
+    status = status == OK ? parcel.readInt64(&eventTime) : status;
+    status = status == OK ? parcel.readString16(&characters) : status;
+    if (status != OK || (serializedHmac && serializedHmac->size() != 32)) {
+        return BAD_VALUE;
+    }
+
+    // Java-created KeyEvents have a null HMAC. Android represents that as
+    // INVALID_HMAC (all zeroes) for injected events; only events returning
+    // from the native dispatcher carry the fixed-size signed value.
+    std::array<uint8_t, 32> hmac{};
+    if (serializedHmac) {
+        std::copy(serializedHmac->begin(), serializedHmac->end(), hmac.begin());
+    }
+    event->initialize(id, deviceId, source, ui::LogicalDisplayId{displayId}, hmac, action,
+                      eventFlags, keyCode, scanCode, metaState, repeatCount, downTime, eventTime);
+    return OK;
+}
