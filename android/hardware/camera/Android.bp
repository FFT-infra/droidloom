cc_binary {
    name: "droidloom-camera-producer",
    // The producer dequeues gralloc buffers and must resolve the platform
    // gralloc mapper, which only a vendor-partition process can see; a copy
    // running from /droidloom aborts with "gralloc-mapper is missing".
    vendor: true,
    srcs: ["producer.cpp"],
    cpp_std: "c++17",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    static_libs: ["virtual_camera_service_aidl-ndk"],
    // vndk/window.h includes nativebase/nativebase.h; both header sets are
    // separate modules, so a vendor build must ask for them explicitly.
    header_libs: [
        "libnativewindow_headers",
        "libnativebase_headers",
    ],
    shared_libs: [
        "libbinder_ndk",
        "liblog",
        "libnativewindow",
    ],
}

cc_test {
    name: "droidloom-camera-protocol-tests",
    srcs: ["protocol_test.cpp"],
    host_supported: true,
    gtest: false,
    cpp_std: "c++17",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "droidloom-camera-layout-probe",
    srcs: ["layout_probe.cpp"],
    cpp_std: "c++17",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: ["libnativewindow"],
}

android_app {
    name: "DroidloomCameraProbe",
    manifest: "probe/AndroidManifest.xml",
    srcs: ["probe/src/**/*.java"],
    platform_apis: true,
    certificate: "testkey",
    privileged: false,
    min_sdk_version: "29",
    target_sdk_version: "35",
    optimize: {
        enabled: false,
    },
    dex_preopt: {
        enabled: false,
    },
}
