Keep the command-stream diagnostics dispatch consistent with v11 support.
These two dispatch cases are also present in the tablet's working Mesa tree.

diff --git a/src/panfrost/genxml/decode_common.c b/src/panfrost/genxml/decode_common.c
--- a/src/panfrost/genxml/decode_common.c
+++ b/src/panfrost/genxml/decode_common.c
@@ -446,6 +446,9 @@ pandecode_cs_binary(struct pandecode_context *ctx, uint64_t bin_gpu_va,
    case 10:
       pandecode_cs_binary_v10(ctx, bin_gpu_va, size);
       break;
+   case 11:
+      pandecode_cs_binary_v11(ctx, bin_gpu_va, size);
+      break;
    case 12:
       pandecode_cs_binary_v12(ctx, bin_gpu_va, size);
       break;
@@ -472,6 +475,9 @@ pandecode_cs_trace(struct pandecode_context *ctx, uint64_t trace_gpu_va,
    case 10:
       pandecode_cs_trace_v10(ctx, trace_gpu_va, size, gpu_id);
       break;
+   case 11:
+      pandecode_cs_trace_v11(ctx, trace_gpu_va, size, gpu_id);
+      break;
    case 12:
       pandecode_cs_trace_v12(ctx, trace_gpu_va, size, gpu_id);
       break;
