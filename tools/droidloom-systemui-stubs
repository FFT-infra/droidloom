#!/usr/bin/env python3
"""Generate no-op Binder adapters from Droidloom's pinned platform AIDL."""
import argparse
import hashlib
import pathlib
import re

repo = pathlib.Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--source', type=pathlib.Path, default=repo / '.work/aosp-m2-source')
parser.add_argument('--check', action='store_true')
args = parser.parse_args()
for interface, path, adapter in [
    ('IStatusBar', 'statusbar/IStatusBar.aidl', 'EmptyStatusBar'),
    ('IKeyguardService', 'policy/IKeyguardService.aidl', 'EmptyKeyguard'),
]:
    source = args.source / 'frameworks/base/core/java/com/android/internal' / path
    original = source.read_text()
    text = re.sub(r'/\*.*?\*/|//[^\n]*', '', original, flags=re.S)
    imports = re.findall(r'^import ([\w.]+);', text, flags=re.M)
    package = re.search(r'package ([\w.]+);', text)[1]
    methods = re.findall(r'\bvoid\s+(\w+)\s*\((.*?)\)\s*;', text, flags=re.S)
    if not methods:
        raise SystemExit(f'No methods in {source}')
    output = ['/* Copyright 2026 Droidloom. SPDX-License-Identifier: GPL-3.0-or-later */',
              '// Generated by tools/droidloom-systemui-stubs; do not edit.',
              '// AIDL SHA-256: ' + hashlib.sha256(original.encode()).hexdigest(),
              'package com.android.systemui.compat;', '', 'import android.os.*;',
              'import ' + package + '.' + interface + ';']
    output.extend('import ' + name + ';' for name in imports)
    output.extend(['', 'public abstract class ' + adapter + ' extends ' + interface + '.Stub {',
                   '    @Override',
                   '    public boolean onTransact(int code, Parcel data, Parcel reply, int flags)',
                   '            throws RemoteException {',
                   '        int uid = Binder.getCallingUid();',
                   '        if (uid != android.os.Process.SYSTEM_UID && uid != 0) {',
                   '            throw new SecurityException("SystemUI callbacks require system UID");',
                   '        }',
                   '        return super.onTransact(code, data, reply, flags);',
                   '    }'])
    for name, parameters in methods:
        parameters = re.sub(r'@\w+(?:\([^)]*\))?\s*|\b(?:in|out|inout)\s+', '', parameters)
        parameters = ' '.join(parameters.split())
        output.append('    @Override public void ' + name + '(' + parameters + ') throws RemoteException {}')
    output.append('}')
    result = '\n'.join(output) + '\n'
    destination = repo / 'android/framework/droidloom-systemui/src/com/android/systemui/compat' / (adapter + '.java')
    if args.check:
        if not destination.exists() or destination.read_text() != result:
            raise SystemExit(f'Stale generated adapter: {destination}')
    else:
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(result)
    print(f'{adapter}: {len(methods)} pinned Binder methods')
