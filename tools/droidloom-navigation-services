#!/usr/bin/env python3
"""Record/verify services.jar built with Droidloom's host system-bar insets patch."""

import argparse
import hashlib
import json
from pathlib import Path
import zipfile


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=("stamp", "verify"))
    parser.add_argument("jar", type=Path)
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    patch = root / "android/framework/0001-droidloom-bottom-navigation-insets.patch"
    lock_path = root / "android/manifest/m2-sparse-source-lock.json"
    lock = json.loads(lock_path.read_text())
    framework = next(project for project in lock["projects"]
                     if project["path"] == "frameworks/base")
    try:
        # Replacing the system-server jar requires actual dex, not a javac/header
        # jar. The property check also survives services' R8 class inlining.
        with zipfile.ZipFile(args.jar) as archive:
            dex_files = [name for name in archive.namelist()
                         if name.startswith("classes") and name.endswith(".dex")]
            if not dex_files or not any(
                    b"ro.vendor.droidloom.surfaceflinger_tasks" in archive.read(name)
                    for name in dex_files):
                raise ValueError("services.jar has no Droidloom navigation policy dex")
        expected = {
            "schema_version": 1,
            "frameworks_base_commit": framework["commit"],
            "source_lock_sha256": digest(lock_path),
            "build_tool_sha256": digest(root / "tools/droidloom-soong-core-smoke"),
            "navigation_patch_sha256": digest(patch),
            "services_jar_sha256": digest(args.jar),
        }
        manifest = args.jar.with_name(args.jar.name + ".droidloom-navigation.json")
        if args.operation == "stamp":
            manifest.write_text(json.dumps(expected, indent=2) + "\n")
        elif json.loads(manifest.read_text()) != expected:
            raise ValueError("services.jar navigation provenance does not match this checkout")
    except (OSError, ValueError, zipfile.BadZipFile) as error:
        parser.exit(1, f"navigation services: {error}\n")


if __name__ == "__main__":
    main()
