#!/usr/bin/env bash
# Install the Android launcher and its host timing collector, preserving data.
set -Eeuo pipefail
stage="${1:?staging directory required}"
boot_id="${2:?verified boot identity required}"
test "$(cat /proc/sys/kernel/random/boot_id)" = "$boot_id"
test "$(uname -m)" = aarch64
test "$(tr '\000' '\n' </proc/device-tree/compatible | head -n1)" = oneplus,aston
test "$(id -u logix)" = 1001
cd "$stage"
sha256sum -c SHA256SUMS
backup="$(mktemp -d "$stage/backup.XXXXXXXX")"
cp -a /etc/droidloom/cell.json /usr/bin/droidloomd "$backup/"
# Existing installations may use a content-addressed runtime. Never mutate
# its files in place: change only these two overrides to the verified bundle.
python3 - "$stage" <<'PY'
import json
import os
import sys
stage = os.path.realpath(sys.argv[1])
if not stage.startswith('/var/lib/droidloom/launcher-updates/'):
    raise SystemExit('refusing unexpected launcher bundle location')
with open('/etc/droidloom/cell.json') as source:
    spec = json.load(source)
replacements = {
    '/vendor/bin/droidloom-task-launcher': 'droidloom-task-launcher',
    '/vendor/lib64/libdroidloom_task_launcher.dylib.so': 'libdroidloom_task_launcher.dylib.so',
}
for target, filename in replacements.items():
    matches = [entry for entry in spec['android_file_overrides'] if entry['target'] == target]
    if len(matches) != 1 or not os.path.isfile(matches[0]['source']):
        raise SystemExit('missing or ambiguous launcher override: ' + target)
    matches[0]['source'] = os.path.join(stage, filename)
with open(os.path.join(stage, 'cell.json'), 'w') as destination:
    json.dump(spec, destination, indent=2)
    destination.write('\n')
PY
user_service() {
    runuser -u logix -- env XDG_RUNTIME_DIR=/run/user/1001 \
        DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1001/bus systemctl --user "$@"
}
rollback() {
    trap - ERR
    user_service stop droidloom.service || true
    systemctl stop droidloomd.service || true
    install -m 0755 "$backup/droidloomd" /usr/bin/droidloomd
    install -m 0644 "$backup/cell.json" /etc/droidloom/cell.json
    systemctl start droidloomd.service || true
    user_service start droidloom.service || true
    echo "launcher update failed; restored $backup" >&2
    exit 1
}
trap rollback ERR
user_service stop droidloom.service
systemctl stop droidloomd.service
install -m 0755 "$stage/droidloomd" /usr/bin/droidloomd
install -m 0644 "$stage/cell.json" /etc/droidloom/cell.json
systemctl start droidloomd.service
user_service start droidloom.service
user_service is-active droidloom.service
test -S /run/user/1001/droidloom/native-bridge.sock
droidloomctl --json status
trap - ERR
printf 'Launcher updated; previous files preserved in %s\n' "$backup"
