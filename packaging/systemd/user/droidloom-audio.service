[Unit]
Description=Droidloom host audio broker
Wants=pipewire.socket
After=pipewire.socket pipewire.service wireplumber.service
PartOf=droidloom.service
Requires=droidloom-audio.socket

[Service]
ExecStart=/usr/bin/droidloom-audio --socket %t/droidloom/audio.sock
EnvironmentFile=-%h/.config/droidloom/audio.env
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
RestrictSUIDSGID=true
# Filesystem namespacing in a user unit implicitly creates a user namespace
# mapping only the host user. That hides Android's audioserver UID from
# SO_PEERCRED, so this cross-UID endpoint must keep the host user namespace.
