[Unit]
Description=Droidloom Android application runtime
PartOf=graphical-session.target
After=graphical-session-pre.target wayland-session-waitenv.service droidloom-audio.service
Wants=droidloom-applications.service droidloom-audio.service
ConditionPathExists=/etc/droidloom/cell.json

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=/usr/lib/environment.d/60-droidloom.conf
Environment=DROIDLOOM_MODE=desktop DROIDLOOM_HOST_NAVIGATION=0
Environment=WAYLAND_DISPLAY= DISPLAY= XDG_CURRENT_DESKTOP= XDG_SESSION_ID=
Environment=DROIDLOOM_COMPOSITOR_PID= DROIDLOOM_COMPOSITOR_START_TICKS=
EnvironmentFile=-%t/droidloom/session.env
ExecStartPre=/usr/bin/systemctl start droidloomd.service
ExecStart=/usr/bin/droidloom-wayland
ExecStartPost=/usr/bin/droidloomctl start --cell
ExecStopPost=/usr/bin/droidloomctl stop --cell
ExecStopPost=/usr/bin/systemctl stop droidloomd.service
Restart=on-failure
RestartSec=1
TimeoutStartSec=150
TimeoutStopSec=150

[Install]
WantedBy=graphical-session.target
